{
  "name": "xkt-generator-tests",
  "version": "1.0.0",
  "description": "XKT生成器自动化测试套件",
  "type": "module",
  "scripts": {
    "test": "npm run test:all",
    "test:api": "node api.test.js",
    "test:e2e": "node e2e.test.js",
    "test:all": "npm run test:api && npm run test:e2e",
    "test:frontend": "cd ../../frontend/v0-aios-database-management && pnpm test",
    "install": "npm install",
    "setup": "npm install && echo '✅ 测试环境准备完成'"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "puppeteer": "^21.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@testing-library/jest-dom": "^6.1.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}