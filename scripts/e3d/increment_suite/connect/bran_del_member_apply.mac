$P SUITE-CONN-DELMEM-APPLY-ALIVE
/AIOS-SUITE-BRAN-S
Q REF
Q NAME
Q MEMB
FTUB 4
Q REF
Q POS
DELETE FTUB
/AIOS-SUITE-BRAN-S
