ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-DELETE-KEEPCHILD-APPLY-ALIVE
/AIOS-SUITE-BOX-A1
!box = !!CE
Q REF
Q NAME
/AIOS-SUITE-EQ-B
INCLUDE $!box
$!box
Q OWNE
/AIOS-SUITE-EQ-A
Q REF
Q NAME
DELETE EQUI
SAVEWORK 'AIOS suite delete/container_keep_child apply: BOX-A1 moved to EQ-B, EQ-A deleted'
$P SUITE-DELETE-KEEPCHILD-APPLY-DONE
ALPHA LOG END
