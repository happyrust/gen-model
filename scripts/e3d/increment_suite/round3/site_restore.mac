-- P79-P81 restore：只删本轮创建的 OWNER 子树，保留 setup 的 BASE 以便 restored RVM 与 before 对齐。
-- 从 SITE 下到 ZONE 再收集，避免从 WORLD 直接 COLLECT 时抓不到孙级 EQUIPMENT。
ALPHA LOG "{{LOG_PATH}}" OVER
$P AMS-R3-SITE-RESTORE-ALIVE
{{WORLD_ANCHOR}}
{{TARGET_NAME}}
{{TARGET_NAME}}-Z
VAR !o COLLECT ALL EQUIPMENT WITH (NAME EQ '{{TARGET_NAME}}-OWNER') FOR CE
DO !e VALUES !o
  !!CE = !e.dbref()
  Q REF
  Q NAME
  DELETE EQUI
ENDDO
{{TARGET_NAME}}
Q MEMB
SAVEWORK 'AMS round3 site restore'
$P AMS-R3-SITE-RESTORE-DONE
ALPHA LOG END
