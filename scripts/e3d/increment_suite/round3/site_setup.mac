-- AMS 原地第三轮：P79-P81 的 run-owned SITE/ZONE + 一个基线 EQUI。
-- 由 Export 在 baseline 之前执行；{{TARGET_NAME}} 必须是 /AIOS-INC-<run-id>-P7x。
ALPHA LOG "{{LOG_PATH}}" OVER
$P AMS-R3-SITE-SETUP-ALIVE
{{WORLD_ANCHOR}}
VAR !old COLLECT ALL SITE WITH (MATCHWILD(NAME,'{{TARGET_NAME}}*')) FOR CE
DO !s VALUES !old
  !!CE = !s.dbref()
  Q REF
  Q NAME
  DELETE SITE
ENDDO
{{WORLD_ANCHOR}}
NEW SITE {{TARGET_NAME}}
NEW ZONE {{TARGET_NAME}}-Z
{{TARGET_NAME}}-Z
NEW EQUIPMENT {{TARGET_NAME}}-BASE
POS E 39000 N 5000 U 0
Q REF
Q NAME
NEW BOX XLEN 200 YLEN 200 ZLEN 200
NAME {{TARGET_NAME}}-BASE-BOX
POS E 0 N 0 U 0
Q REF
Q NAME
{{TARGET_NAME}}
Q MEMB
SAVEWORK 'AMS round3 site setup'
$P AMS-R3-SITE-SETUP-DONE
ALPHA LOG END
