-- 登记: 大窗的对照（CT-S3 删除 + CT-W10 大窗） | 语义: support/compre_bulk_copy_only_apply.mac 的还原——删掉自建的 /AIOS-SUITE-T1-BULK*。
-- 预期：250132 这一窗只有删除（1564 个元素）；被支撑的支管没变，COMPRE 不触发、不交接。
-- expected_net: deleted | apply 搭档: support/compre_bulk_copy_only_apply.mac
--
-- 工程: APS（AvevaPlantSample，MDB /ALL）。只在私有副本上跑。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-SUPPORT-BULK-COPY-ONLY-RESTORE-ALIVE
/SITE-PIPING-AREA01
Q REF
Q NAME
OWNER
VAR !old COLLECT ALL SITE WITH (MATCHWILD(NAME,'/AIOS-SUITE-T1-BULK*')) FOR CE
DO !s VALUES !old
  !!CE = !s.dbref()
  Q REF
  Q NAME
  DELETE SITE
ENDDO
$P SUITE-SUPPORT-BULK-COPY-ONLY-RESTORE-DELETED
SAVEWORK 'AIOS suite support/compre_bulk_copy_only restore: zone copies deleted'
$P SUITE-SUPPORT-BULK-COPY-ONLY-RESTORE-DONE
ALPHA LOG END
