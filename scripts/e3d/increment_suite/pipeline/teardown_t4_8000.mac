-- T4 语料收场（主库这一半）：只删自己的 SITE /AIOS-SUITE-T4。公共基线和别人的 SITE 不碰。
-- 按名 COLLECT 再删，SITE 不在时只是空转。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T4-TEARDOWN-8000-ALIVE
{{WORLD_ANCHOR}}
VAR !old COLLECT ALL SITE WITH (MATCHWILD(NAME,'/AIOS-SUITE-T4*')) FOR CE
DO !s VALUES !old
  !!CE = !s.dbref()
  Q REF
  Q NAME
  DELETE SITE
ENDDO
SAVEWORK 'AIOS suite T4: teardown db8000 (delete SITE /AIOS-SUITE-T4)'
$P SUITE-T4-TEARDOWN-8000-DONE
ALPHA LOG END