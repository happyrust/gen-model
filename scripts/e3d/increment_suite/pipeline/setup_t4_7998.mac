-- T4 语料（后端管线行为类），伙伴库这一半：db7998 里自己的 SITE /AIOS-SUITE-T4-X。
-- 幂等：先按名删掉旧的，再整套重建。收场用 pipeline/teardown_t4_7998.mac。
-- 名字不以 /AIOS-SUITE-7998 开头：公共的 h03 setup / teardown 按那个前缀整片删。
-- 入口用 7998 的 WORLD 引用（=16190/0，永远存在），与 h03/setup_7998.mac 同一个办法。
--
-- 里面有什么：
--   两间自建的房 R901、R902（FRMW -> PANE -> PLOO 高 2000 -> 四个顶点），做法照 L3 夹具的 setup：
--     R901 的地板轮廓 E 118000..122000 / N 58000..62000，里面是主库 8000 的 EQ-RM1；
--     R902 的地板轮廓 E 128000..132000 / N 58000..62000，里面是主库 8000 的 EQ-RM2（对照）。
--     房间在一个库、房里的设备在另一个库——真实工程（AMS 样例）就是这样分的。
--   ZONE BULKZ：空的，「小库里一次建一大批」打在它下面。
--   EQ-X：一次保存同时动两个库时，伙伴库这边挪的就是它。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T4-SETUP-7998-ALIVE
=16190/0
VAR !old COLLECT ALL SITE WITH (MATCHWILD(NAME,'/AIOS-SUITE-T4*')) FOR CE
DO !s VALUES !old
  !!CE = !s.dbref()
  Q REF
  Q NAME
  DELETE SITE
ENDDO
=16190/0
NEW SITE /AIOS-SUITE-T4-X
Q REF
Q NAME
NEW ZONE /AIOS-SUITE-T4-X-RMZ
Q REF
Q NAME
NEW STRU /AIOS-SUITE-T4-X-STRU
Q REF
Q NAME
NEW FRMW /AIOS-SUITE-T4-RM-R901
Q REF
Q NAME
NEW PANE /AIOS-SUITE-T4-RM-R901-P1
POS E 0 N 0 U 0
Q REF
Q NAME
NEW PLOO /AIOS-SUITE-T4-RM-R901-PL
HEIG 2000
NEW PAVE /AIOS-SUITE-T4-RM-R901-V1
POS E 118000 N 58000 U 0
NEW PAVE /AIOS-SUITE-T4-RM-R901-V2
POS E 122000 N 58000 U 0
NEW PAVE /AIOS-SUITE-T4-RM-R901-V3
POS E 122000 N 62000 U 0
NEW PAVE /AIOS-SUITE-T4-RM-R901-V4
POS E 118000 N 62000 U 0
/AIOS-SUITE-T4-X-STRU
NEW FRMW /AIOS-SUITE-T4-RM-R902
Q REF
Q NAME
NEW PANE /AIOS-SUITE-T4-RM-R902-P1
POS E 0 N 0 U 0
Q REF
Q NAME
NEW PLOO /AIOS-SUITE-T4-RM-R902-PL
HEIG 2000
NEW PAVE /AIOS-SUITE-T4-RM-R902-V1
POS E 128000 N 58000 U 0
NEW PAVE /AIOS-SUITE-T4-RM-R902-V2
POS E 132000 N 58000 U 0
NEW PAVE /AIOS-SUITE-T4-RM-R902-V3
POS E 132000 N 62000 U 0
NEW PAVE /AIOS-SUITE-T4-RM-R902-V4
POS E 128000 N 62000 U 0
/AIOS-SUITE-T4-X
NEW ZONE /AIOS-SUITE-T4-X-BULKZ
Q REF
Q NAME
/AIOS-SUITE-T4-X
NEW ZONE /AIOS-SUITE-T4-X-EQZ
Q REF
Q NAME
NEW EQUIPMENT /AIOS-SUITE-T4-EQ-X
POS E 125000 N 75000 U 0
Q REF
Q NAME
NEW BOX XLEN 800 YLEN 600 ZLEN 400
NAME /AIOS-SUITE-T4-BOX-X
Q REF
Q NAME
/AIOS-SUITE-T4-X
Q MEMB
/AIOS-SUITE-T4-RM-R901-PL
Q MEMB
SAVEWORK 'AIOS suite T4: setup db7998 (SITE /AIOS-SUITE-T4-X)'
$P SUITE-T4-SETUP-7998-DONE
ALPHA LOG END
