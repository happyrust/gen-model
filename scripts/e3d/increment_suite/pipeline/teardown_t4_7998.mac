-- T4 语料收场（伙伴库这一半）：只删 db7998 里自己的 SITE /AIOS-SUITE-T4-X。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T4-TEARDOWN-7998-ALIVE
=16190/0
VAR !old COLLECT ALL SITE WITH (MATCHWILD(NAME,'/AIOS-SUITE-T4*')) FOR CE
DO !s VALUES !old
  !!CE = !s.dbref()
  Q REF
  Q NAME
  DELETE SITE
ENDDO
SAVEWORK 'AIOS suite T4: teardown db7998 (delete SITE /AIOS-SUITE-T4-X)'
$P SUITE-T4-TEARDOWN-7998-DONE
ALPHA LOG END