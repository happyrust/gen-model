-- T4 语料（后端管线行为类），主库这一半：db8000 里自己的 SITE /AIOS-SUITE-T4。
-- 幂等：先按名删掉旧的 T4 SITE，再整套重建。收场用 pipeline/teardown_t4_8000.mac。
-- 不依赖公共基线，也不碰生产元素。世界锚点占位符渲染成两行（进 db8000、上跳到它的 WORLD）。
--
-- 里面有什么：
--   EQ-RM1  在 E 120000 N 60000 U 1000，150 的小盒子：落在伙伴库 7998 里那间自建房 R901 的地板轮廓里
--   EQ-RM2  在 E 130000 N 60000 U 1000：落在 R902 里，当对照（R902 这一组用例里不动）
--   EQ-CLM  只盖戳的保存（认领再释放）打在它上面
--   EQ-MV   一次保存同时动两个库时，主库这边挪的就是它
-- 坐标都在 E 120000..140000 / N 60000..80000，离套件原有语料、T1 / T3 的语料和真实房间都远。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T4-SETUP-8000-ALIVE
{{WORLD_ANCHOR}}
VAR !old COLLECT ALL SITE WITH (MATCHWILD(NAME,'/AIOS-SUITE-T4*')) FOR CE
DO !s VALUES !old
  !!CE = !s.dbref()
  Q REF
  Q NAME
  DELETE SITE
ENDDO
{{WORLD_ANCHOR}}
NEW SITE /AIOS-SUITE-T4
Q REF
Q NAME
NEW ZONE /AIOS-SUITE-T4-Z
Q REF
Q NAME
NEW EQUIPMENT /AIOS-SUITE-T4-EQ-RM1
POS E 120000 N 60000 U 1000
Q REF
Q NAME
NEW BOX XLEN 150 YLEN 150 ZLEN 150
NAME /AIOS-SUITE-T4-BOX-RM1
Q REF
Q NAME
NEW EQUIPMENT /AIOS-SUITE-T4-EQ-RM2
POS E 130000 N 60000 U 1000
Q REF
Q NAME
NEW BOX XLEN 150 YLEN 150 ZLEN 150
NAME /AIOS-SUITE-T4-BOX-RM2
Q REF
Q NAME
NEW EQUIPMENT /AIOS-SUITE-T4-EQ-CLM
POS E 120000 N 70000 U 0
DESC 'AIOS T4 claim target'
Q REF
Q NAME
NEW BOX XLEN 800 YLEN 600 ZLEN 400
NAME /AIOS-SUITE-T4-BOX-CLM
Q REF
Q NAME
NEW EQUIPMENT /AIOS-SUITE-T4-EQ-MV
POS E 125000 N 70000 U 0
Q REF
Q NAME
NEW BOX XLEN 800 YLEN 600 ZLEN 400
NAME /AIOS-SUITE-T4-BOX-MV
Q REF
Q NAME
/AIOS-SUITE-T4-Z
Q MEMB
SAVEWORK 'AIOS suite T4: setup db8000 (SITE /AIOS-SUITE-T4)'
$P SUITE-T4-SETUP-8000-DONE
ALPHA LOG END
