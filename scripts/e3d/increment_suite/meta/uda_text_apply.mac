ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T3-META-UDA-TEXT-APPLY-ALIVE
/AIOS-SUITE-T3-EQ-CP
Q REF
Q NAME
Q :EQNA
Q UDASET
:EQNA 'AIOS T3 eqna changed'
Q :EQNA
Q UDASET
SAVEWORK 'AIOS suite T3 meta/uda_text apply: EQ-CP UDA EQNA changed'
$P SUITE-T3-META-UDA-TEXT-APPLY-DONE
ALPHA LOG END
