-- 登记: G03 | 语义: V2/V3 写回 PLOO 局部坐标 W 150 | expected_net: cancelled
-- restore 搭档: 本文件是 room/pave_move_apply.mac 的 restore
-- 改前实测：V2 是 W 150mm N 150mm U 0mm，V3 是 W 150mm S 150mm U 0mm。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-ROOM-PAVE-RESTORE-ALIVE
/AIOS-SUITE-RM-R201-P1
Q REF
Q NAME
/AIOS-SUITE-RM-R201-P1-V2
Q REF
Q POS
POS E -150 N 150 U 0
Q POS
/AIOS-SUITE-RM-R201-P1-V3
Q REF
Q POS
POS E -150 N -150 U 0
Q POS
SAVEWORK 'AIOS suite room/pave_move restore: R201-P1 V2/V3 local W 150'
$P SUITE-ROOM-PAVE-RESTORE-DONE
ALPHA LOG END
