$P SUITE-ROOM-PAVE-RESTORE-ALIVE
/AIOS-SUITE-RM-R201-P1
Q REF
Q NAME
/AIOS-SUITE-RM-R201-P1-V2
Q REF
Q POS
POS E 8803 N 10975 U 6570
Q POS
/AIOS-SUITE-RM-R201-P1-V3
Q REF
Q POS
POS E 8803 N 10975 U 6870
Q POS
SAVEWORK 'AIOS suite room/pave_move restore: R201-P1 east edge back to E 8803'
$P SUITE-ROOM-PAVE-RESTORE-DONE
