ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-PROBE-PIPE-ALIVE
VAR !p COLLECT ALL PIPE FOR CE
Q VAR !p
DO !x VALUES !p
  !!CE = !x.dbref()
  Q NAME
  Q REF
  Q MEMB
ENDDO
$P SECTION_SITES
VAR !s COLLECT ALL SITE FOR CE
DO !y VALUES !s
  !!CE = !y.dbref()
  Q NAME
ENDDO
$P SUITE-PROBE-PIPE-DONE
ALPHA LOG END
