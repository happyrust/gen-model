ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-PROBE-NAMES-ALIVE
{{WORLD_ANCHOR}}
$P SECTION_BRAN_S
VAR !b COLLECT ALL BRAN WITH (MATCHWILD(NAME,'/AIOS-SUITE-BRAN-S')) 
IF (!b.SIZE() GT 0) THEN
  $P BRAN_S_FOUND
  !!CE = !b[1].dbref()
  Q REF
  Q NAME
  Q MEMB
ELSE
  $P BRAN_S_MISSING
ENDIF
$P SECTION_M2
VAR !m COLLECT ALL WITH (MATCHWILD(NAME,'/AIOS-SUITE-BRAN-S-M*'))
IF (!m.SIZE() GT 0) THEN
  $P M2_FOUND
  DO !x VALUES !m
    !!CE = !x.dbref()
    Q NAME
    Q TYPE
  ENDDO
ELSE
  $P M2_MISSING
ENDIF
$P SUITE-PROBE-NAMES-DONE
ALPHA LOG END
