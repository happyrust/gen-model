-- 基线：SITE /AIOS-SUITE-8000 下一个 ZONE；EQ-A(+BOX-A1)、EQ-B(空)、EQ-NBX(BOX-N 下挂 NBOX)、EQ-NOZ（COPY 生产带 NOZZ 设备）、
-- PIPE-P（COPY 生产 PIPE）、BRAN-S（COPY /C-OR-1R345-C）、房间 STRU/FRMW R201,R202 + EQ-RM。
--
-- ★ 命名纪律（2026-10-28）：本套件的**每一个元素都必须有显式 NAME**，不许留 E3D 自动命名。
--   原因：RVM 真值比对按名匹配（Compare-SuiteRvmTruth.ps1 的键 = 导出根以下的相对路径），
--   而 E3D 自动命名是 `BOX 1 of EQUIPMENT /xxx`、`PAVERT 3 of PLOOP 1 of PANEL /xxx` 这类
--   带序号的形态——序号会随成员增删而变化，refno 也会随重建变化，只有显式名字稳定。
--   实测（2026-10-28）：COPY 进来的子件**全部不带名字**（BRAN-S 的 9 个成员、PIPE-P 的 19 个
--   BRAN 都是纯 refno），必须在 COPY 之后逐个补 NAME。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-SETUP-8000-ALIVE
{{WORLD_ANCHOR}}
VAR !old COLLECT ALL SITE WITH (MATCHWILD(NAME,'/AIOS-SUITE-8000*')) FOR CE
DO !s VALUES !old
  !!CE = !s.dbref()
  DELETE SITE
ENDDO
{{WORLD_ANCHOR}}
NEW SITE /AIOS-SUITE-8000
NEW ZONE /AIOS-SUITE-8000-Z
!zone = !!CE
NEW EQUIPMENT /AIOS-SUITE-EQ-A
DESC 'AIOS baseline'
POS E 40000 N 5000 U 0
Q REF
Q NAME
NEW BOX XLEN 2000 YLEN 1000 ZLEN 500
NAME /AIOS-SUITE-BOX-A1
Q REF
Q NAME
!!CE = !zone
NEW EQUIPMENT /AIOS-SUITE-EQ-B
POS E 43000 N 5000 U 0
Q REF
Q NAME
!!CE = !zone
-- ★ 设备语料改造（2026-10-28）：EQ-NBX 改用 ams 真实设备 /1-RFH-437-SN。
--   实测（probe_equi_detail）：该设备是 EQUI + 1 个 CYLI 子件（Ø38 × H52），
--   在 db8000 里是**唯一带 CYLI 的设备**（其余 100+ EQUI 全是 BOX 或 ELCONN）。
--   COPY 后挪到套件区域并放大尺寸，因为 Ø38 太小、AABB 比对精度吃紧。
--
--   ★ 但 BOX-N + NBOX-N1 这一对仍是自造：db8000 里没有任何真实负实体（NBOX），
--     而 geom/nbox_* 三条用例需要 NBOX 挂在 BOX 之下，只能自建。
--     所以 EQ-NBX 下同时有：真实 CYLI（来自 COPY）+ 自造 BOX-N/NBOX-N1。
NEW EQUIPMENT /AIOS-SUITE-EQ-NBX
POS E 46000 N 5000 U 0
Q REF
Q NAME
NEW BOX XLEN 2000 YLEN 2000 ZLEN 2000
NAME /AIOS-SUITE-BOX-N
Q REF
Q NAME
NEW NBOX
XLEN 500
YLEN 500
ZLEN 2500
NAME /AIOS-SUITE-NBOX-N1
Q REF
Q NAME
-- 真实 CYLI：COPY ams 的 /1-RFH-437-SN，只留 CYLI，放大到可测尺寸
-- ★ 用 POS 绝对值而不是 BY：BY 是相对原件位置的偏移，而原件在 E1830 S24670 U4088，
--   BY E 52000 N 5000 U 0 会把设备带到 N -20420（跑到套件区域外，实测踩过）。
!!CE = !zone
NEW EQUIPMENT /AIOS-SUITE-EQ-CYLI
COPY /1-RFH-437-SN
Q REF
Q NAME
Q MEMB
POS E 52000 N 5000 U 0
Q POS WRT /*
/AIOS-SUITE-EQ-CYLI
!cm = !!CE.MEMBERS
DO !cx VALUES !cm
  !!CE = !cx
  IF (!!CE.TYPE EQ 'CYLI') THEN
    !cn = !!CE.NAME
    IF (NOT MATCHWILD(!cn,'/*')) THEN
      NAME /AIOS-SUITE-CYLI-1
    ENDIF
    DIAM 1500
    HEIG 3000
    Q NAME
    Q DIAM
    Q HEIG
  ENDIF
ENDDO
!!CE = !zone
NEW EQUIPMENT /AIOS-SUITE-EQ-NOZ
COPY /1-LNR-Q005-PJ
Q REF
Q NAME
Q MEMB
BY E 49000
-- ★ COPY 带过来的 BOX 不带名字，补一个（命名纪律见文件头）
-- ★ 判据必须用 MATCHWILD(NAME,'/*')，**不能**用 NAME EQ ''：
--   实测（2026-10-28）无名元素的 NAME 属性返回的是 refno 字符串 `'=24384/27392'`，不是空串，
--   所以 `IF (!!CE.NAME EQ '')` 永远为假，整段补名会被静默跳过。
/AIOS-SUITE-EQ-NOZ
!nb = !!CE.MEMBERS
DO !b VALUES !nb
  !!CE = !b
  IF (!!CE.TYPE EQ 'BOX') THEN
    !cn = !!CE.NAME
    IF (NOT MATCHWILD(!cn,'/*')) THEN
      NAME /AIOS-SUITE-EQ-NOZ-BOX
    ENDIF
  ENDIF
ENDDO
/AIOS-SUITE-EQ-NOZ
Q MEMB
-- ★ TTY 实测（2026-10-28）：COPY /1-LNR-Q005-PJ 只带过来 1 个 BOX，**没有 NOZZ**。
-- 而 db8000 全库 40+ 个 EQUI 里也没有一个带 NOZZ（findnozz 探针：FN-HIT 计数 0）。
-- 所以 connect/nozz_move 与 xform/noz_move 原本没有靶子，会在 !nozzs[1] 越界崩掉。
-- 这里显式建一个 NOZZ 当靶（NEW NOZZ 已实测成立：Ref =24384/26717）。
-- 注意：这是**自建元素**，符合「不动生产元素」纪律；生产设备上没有 NOZZ 可动。
NEW NOZZ /AIOS-SUITE-NOZZ-1
Q REF
Q NAME
Q POS
!!CE = !zone
NEW PIPE /AIOS-SUITE-PIPE-P
COPY /1RX-345
Q REF
Q NAME
Q MEMB
-- ★ COPY 带过来的 19 条 BRAN 都不带名字，按序号补 /AIOS-SUITE-PIPE-P-BRAN-<n>
-- ★ 用 MEMBERS 而不是 COLLECT ALL FOR CE：后者会额外抓到 `IL TUB OF =xxx` 这类隐含元素
--   （实测 BRAN-S 下 COLLECT 得到 12 个，MEMBERS 只有 9 个），隐含元素不能命名。
-- ★ 拼名字必须用单引号内插 `'/xxx-$!i'`，**不能**用 `'/xxx-' + !i`：
--   实测 PML 不支持 STRING + REAL（报 `Method <STRING>.+(<REAL>) not found`），
--   `!nm` 会保持 Undefined，随后 `NAME $!nm` 报 `Variable NM not defined` 而静默失败。
/AIOS-SUITE-PIPE-P
!br = !!CE.MEMBERS
!i = 0
DO !b VALUES !br
  !!CE = !b
  IF (!!CE.TYPE EQ 'BRAN') THEN
    !i = !i + 1
    !cn = !!CE.NAME
    IF (NOT MATCHWILD(!cn,'/*')) THEN
      !nm = '/AIOS-SUITE-PIPE-P-BRAN-$!i'
      NAME $!nm
    ENDIF
  ENDIF
ENDDO
/AIOS-SUITE-PIPE-P
Q MEMB
-- ★ 再补一层：每条 BRAN 自己的管件成员（FTUB/BEND/ELBO）也都不带名字。
--   RVM 导出会把这些管件当成成员节点，名字就是 `FTUBE 1 of BRANCH /xxx` 这种带序号的缺省名，
--   序号随弯头增删而变，比对时无法作为稳定键。这里按 BRAN 序号 + 成员序号命名。
!bi = 0
DO !b VALUES !br
  !!CE = !b
  IF (!!CE.TYPE EQ 'BRAN') THEN
    !bi = !bi + 1
    !sub = !!CE.MEMBERS
    !mi = 0
    DO !s VALUES !sub
      !!CE = !s
      !mi = !mi + 1
      !cn = !!CE.NAME
      IF (NOT MATCHWILD(!cn,'/*')) THEN
        !nm = '/AIOS-SUITE-PIPE-P-BRAN-$!bi-P$!mi'
        NAME $!nm
      ENDIF
    ENDDO
  ENDIF
ENDDO
/AIOS-SUITE-PIPE-P
Q MEMB
NEW BRAN /AIOS-SUITE-BRAN-S
COPY /C-OR-1R345-C
Q REF
Q NAME
Q MEMB
-- ★ COPY 带过来的 9 个成员（FTUB/BEND）都不带名字，按序补 /AIOS-SUITE-BRAN-S-M<n>
-- ★ FTUB / BEND 都可命名（实测 2026-10-28：NAME 后 Type BEND、Ref 不变）。
/AIOS-SUITE-BRAN-S
!mb = !!CE.MEMBERS
!i = 0
DO !m VALUES !mb
  !!CE = !m
  !i = !i + 1
  !cn = !!CE.NAME
  IF (NOT MATCHWILD(!cn,'/*')) THEN
    !nm = '/AIOS-SUITE-BRAN-S-M$!i'
    NAME $!nm
  ENDIF
ENDDO
/AIOS-SUITE-BRAN-S
Q MEMB
!!CE = !zone
NEW STRU /AIOS-SUITE-ROOM-STRU
!stru = !!CE
-- ★ 房间语料改用 ams 真实房间（2026-10-28 改造）：
--   原先是自造 FRMW/PANE/PLOO/PAVE 四个顶点。现在改成 COPY 生产房间
--   /1RS-WF04-W-AB（db1112 的真实房间，19 面墙），COPY 后只留第 1 面墙
--   （CWALL R4501，带 2 个 PANE），其余 18 面墙 DELETE。
--
--   为什么裁墙：整个房间有 19 CWALL + 数百 PANE，搬进套件会让 RVM 成员数
--   从 148 涨到上千，录制与比对成本不可接受。留 1 面墙（2 PANE × 4 PAVE）
--   既保住真实命名与真实坐标，又把规模控制在可录范围内。
--
--   ★ 层级实测（probe_pane_owner / probe_room_trim / probe_pave_check）：
--     FRMW → CWALL → PANE → PLOO → PAVERT 1..4
--     PANE 不是挂在 FRMW 直接子级，而是挂在 CWALL 下。所以 COPY FRMW 后
--     必须穿过 CWALL 才能摸到 PANE。
--   ★ COPY 只能进空容器：`Cannot copy into an element which already has members`
--     所以必须 NEW FRMW（空）再 COPY，不能 NEW FRMW 之后又建别的。
NEW FRMW /AIOS-SUITE-RM-R201
COPY /1RS-WF04-W-AB
-- 只留第 1 面墙，其余 DELETE CWALL
/AIOS-SUITE-RM-R201
!all = !!CE.MEMBERS
!keep = 0
DO !c VALUES !all
  !!CE = !c
  IF (!!CE.TYPE EQ 'CWALL') THEN
    !keep = !keep + 1
    IF (!keep GT 1) THEN
      DELETE CWALL
    ENDIF
  ENDIF
ENDDO
-- 补名：CWALL / PANE / PLOO / PAVE 全部要有显式名（命名纪律见文件头）
-- ★ 判据用 MATCHWILD(NAME,'/*')，不能用 NAME EQ ''（无名元素返回 refno 串）
/AIOS-SUITE-RM-R201
!ws = !!CE.MEMBERS
!wi = 0
DO !w VALUES !ws
  !!CE = !w
  IF (!!CE.TYPE EQ 'CWALL') THEN
    !wi = !wi + 1
    !cn = !!CE.NAME
    IF (NOT MATCHWILD(!cn,'/*')) THEN
      !nm = '/AIOS-SUITE-RM-R201-W$!wi'
      NAME $!nm
    ENDIF
    !ps = !!CE.MEMBERS
    !pi = 0
    DO !p VALUES !ps
      !!CE = !p
      IF (!!CE.TYPE EQ 'PANE') THEN
        !pi = !pi + 1
        !cn = !!CE.NAME
        IF (NOT MATCHWILD(!cn,'/*')) THEN
          !nm = '/AIOS-SUITE-RM-R201-P$!pi'
          NAME $!nm
        ENDIF
        !ls = !!CE.MEMBERS
        !li = 0
        DO !l VALUES !ls
          !!CE = !l
          IF (!!CE.TYPE EQ 'PLOO') THEN
            !li = !li + 1
            !cn = !!CE.NAME
            IF (NOT MATCHWILD(!cn,'/*')) THEN
              !nm = '/AIOS-SUITE-RM-R201-P$!pi-PLOO'
              NAME $!nm
            ENDIF
            !vs = !!CE.MEMBERS
            !vi = 0
            DO !v VALUES !vs
              !!CE = !v
              IF (!!CE.TYPE EQ 'PAVE') THEN
                !vi = !vi + 1
                !cn = !!CE.NAME
                IF (NOT MATCHWILD(!cn,'/*')) THEN
                  !nm = '/AIOS-SUITE-RM-R201-P$!pi-V$!vi'
                  NAME $!nm
                ENDIF
              ENDIF
            ENDDO
          ENDIF
        ENDDO
      ENDIF
    ENDDO
  ENDIF
ENDDO
-- 第二间房：同样是真实房间语料，COPY 同一房间再裁到 1 面墙，
-- 挪到不同位置以便 room/member_move 有「跨房间」的目标。
!!CE = !stru
NEW FRMW /AIOS-SUITE-RM-R202
COPY /1RS-WF04-W-AB
/AIOS-SUITE-RM-R202
!all2 = !!CE.MEMBERS
!keep2 = 0
DO !c2 VALUES !all2
  !!CE = !c2
  IF (!!CE.TYPE EQ 'CWALL') THEN
    !keep2 = !keep2 + 1
    IF (!keep2 GT 1) THEN
      DELETE CWALL
    ENDIF
  ENDIF
ENDDO
BY E 8000
/AIOS-SUITE-RM-R202
!ws2 = !!CE.MEMBERS
!wi2 = 0
DO !w2 VALUES !ws2
  !!CE = !w2
  IF (!!CE.TYPE EQ 'CWALL') THEN
    !wi2 = !wi2 + 1
    !cn = !!CE.NAME
    IF (NOT MATCHWILD(!cn,'/*')) THEN
      !nm = '/AIOS-SUITE-RM-R202-W$!wi2'
      NAME $!nm
    ENDIF
    !ps2 = !!CE.MEMBERS
    !pi2 = 0
    DO !p2 VALUES !ps2
      !!CE = !p2
      IF (!!CE.TYPE EQ 'PANE') THEN
        !pi2 = !pi2 + 1
        !cn = !!CE.NAME
        IF (NOT MATCHWILD(!cn,'/*')) THEN
          !nm = '/AIOS-SUITE-RM-R202-P$!pi2'
          NAME $!nm
        ENDIF
        !ls2 = !!CE.MEMBERS
        !li2 = 0
        DO !l2 VALUES !ls2
          !!CE = !l2
          IF (!!CE.TYPE EQ 'PLOO') THEN
            !li2 = !li2 + 1
            !cn = !!CE.NAME
            IF (NOT MATCHWILD(!cn,'/*')) THEN
              !nm = '/AIOS-SUITE-RM-R202-P$!pi2-PLOO'
              NAME $!nm
            ENDIF
            !vs2 = !!CE.MEMBERS
            !vi2 = 0
            DO !v2 VALUES !vs2
              !!CE = !v2
              IF (!!CE.TYPE EQ 'PAVE') THEN
                !vi2 = !vi2 + 1
                !cn = !!CE.NAME
                IF (NOT MATCHWILD(!cn,'/*')) THEN
                  !nm = '/AIOS-SUITE-RM-R202-P$!pi2-V$!vi2'
                  NAME $!nm
                ENDIF
              ENDIF
            ENDDO
          ENDIF
        ENDDO
      ENDIF
    ENDDO
  ENDIF
ENDDO
!!CE = !zone
NEW EQUIPMENT /AIOS-SUITE-EQ-RM
-- ★ 2026-10-28 语料改造：EQ-RM 初始位置放进 ams 真实房间 R201 的墙板内。
--   原因：room/member_move 的语义是「EQ-RM 从 R201 跨入 R202」，要求它一开始就**属于 R201**。
--   原位置 E 60000 N 5000 是自造房间时代的值，不在任何真实房间范围内，跨房间语义不成立。
--   R201-P2 实测 AABB [8585.30, 10750.42, 6430.00, 8821.75, 10973.30, 6730.00]，
--   取中心 E 8703 N 10861 U 6580。
--   ★ BOX 从 500³ 缩到 150³：真实房间的 PANE 是**墙板**（实测 236×223×300mm），
--     不是房间地板轮廓，500³ 的盒子八顶点不可能全落在面板内（room_predicate.rs:31 的 Inside 判据
--     要求八顶点全在面板内），归属判不出来。
--   150³ 居中后 [8628.5, 10786.9, 6505.0, 8778.5, 10936.9, 6655.0]，全在面板内。
POS E 8703 N 10861 U 6580
Q REF
Q NAME
NEW BOX XLEN 150 YLEN 150 ZLEN 150
NAME /AIOS-SUITE-BOX-RM
Q REF
Q NAME
SAVEWORK 'AIOS suite: baseline setup db8000'
$P SUITE-SETUP-8000-DONE
ALPHA LOG END
