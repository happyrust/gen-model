ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-TEARDOWN-8000-ALIVE
{{WORLD_ANCHOR}}
VAR !sites COLLECT ALL SITE WITH (MATCHWILD(NAME,'/AIOS-SUITE-8000*')) FOR CE
DO !s VALUES !sites
  !!CE = !s.dbref()
  Q REF
  Q NAME
  DELETE SITE
ENDDO
SAVEWORK 'AIOS suite: teardown db8000'
$P SUITE-TEARDOWN-8000-DONE
ALPHA LOG END
