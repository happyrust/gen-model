-- 只读探针：确认 /AIOS-SUITE-BRAN-S 与 /AIOS-SUITE-BRAN-S-M2 是否还在。
-- 用途：pipe/spre_swap 两腿 exit=1（0xC0000005 访问违例），怀疑 M2 名字不存在。
--
-- ★ 纪律：E3D 导航到不存在的元素会崩（exit=3221225477），所以每条导航前先判存在。
--   判据用 COLLECT + MATCHWILD，不直接 /name。
--
-- 只读，不写库。

ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-PROBE-BRAN-S-ALIVE

$P SECTION_FIND_BRAN_S
VAR !b COLLECT ALL BRAN WITH (MATCHWILD(NAME,'/AIOS-SUITE-BRAN-S')) FOR CE
Q VAR !b
IF (!b.SIZE() GT 0) THEN
  $P SECTION_BRAN_S_FOUND
  !!CE = !b[1].dbref()
  Q REF
  Q NAME
  Q MEMB
ELSE
  $P SECTION_BRAN_S_MISSING
ENDIF

$P SECTION_FIND_M2
VAR !m COLLECT ALL BEND WITH (MATCHWILD(NAME,'/AIOS-SUITE-BRAN-S-M*')) FOR CE
Q VAR !m
IF (!m.SIZE() GT 0) THEN
  $P SECTION_M2_FOUND
  DO !x VALUES !m
    !!CE = !x.dbref()
    Q NAME
    Q REF
    Q TYPE
  ENDDO
ELSE
  $P SECTION_M2_MISSING
ENDIF

$P SECTION_FIND_ANY_M
VAR !am COLLECT ALL WITH (MATCHWILD(NAME,'/AIOS-SUITE-BRAN-S-M*')) FOR CE
Q VAR !am
IF (!am.SIZE() GT 0) THEN
  $P SECTION_ANY_M_FOUND
  DO !y VALUES !am
    !!CE = !y.dbref()
    Q NAME
    Q TYPE
  ENDDO
ELSE
  $P SECTION_ANY_M_MISSING
ENDIF

$P SUITE-PROBE-BRAN-S-DONE
ALPHA LOG END
