-- 只读探针：取 ams 真实房间 R201-P1 的四个 PAVE 顶点坐标。
-- 用途：pave_move 用例要按真实坐标改顶点（原宏里写死的 E62000→64000 是自造房间的值）。
--
-- 只读，不写库。

ONERROR CONTINUE
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-PAVE-VERTICES-ALIVE

$P SECTION_R201_P1_PAVES
/AIOS-SUITE-RM-R201-P1
Q REF
Q NAME
Q MEMB
VAR !pv COLLECT ALL PAVE FOR CE
DO !p VALUES !pv
  !!CE = !p.dbref()
  Q REF
  Q POS WRT /*
ENDDO

$P SECTION_R201_P2_PAVES
/AIOS-SUITE-RM-R201-P2
Q REF
Q NAME
Q MEMB
VAR !pv2 COLLECT ALL PAVE FOR CE
DO !p2 VALUES !pv2
  !!CE = !p2.dbref()
  Q REF
  Q POS WRT /*
ENDDO

$P SUITE-PAVE-VERTICES-DONE
ALPHA LOG END
