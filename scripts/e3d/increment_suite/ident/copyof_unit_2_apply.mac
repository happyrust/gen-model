-- 登记: A02（变更类型 CT-A4；按名称案例 C-08、C-09） | 语义: 改了上一腿建的两台设备各自的 BOX 的长度：自动命名那台的从 500 改成 800，名字中间含 Copy-of 那台的从 300 改成 450
-- expected_net: cancelled（三腿链 ident/copyof_unit 的第 2 腿）
-- 预期 gen-model（按 refno）: 两台设备各重建一次；别的设备不动；没有 datacenter_delete。
-- 按 COLLECT 找这两个 BOX：不在时只是空转，不会把会话带崩。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T3-COPYOF-UNIT-2-APPLY-ALIVE
/AIOS-SUITE-T3-Z
Q REF
Q NAME
VAR !a COLLECT ALL BOX WITH (NAME EQ '/Copy-of-AIOS-SUITE-T3-BOX-CP1') FOR CE
DO !b VALUES !a
  !!CE = !b.dbref()
  Q REF
  Q NAME
  Q XLEN
  XLEN 800
  Q XLEN
  OWNER
  Q REF
  Q NAME
ENDDO
/AIOS-SUITE-T3-Z
VAR !c COLLECT ALL BOX WITH (NAME EQ '/AIOS-SUITE-T3-Copy-of-BOX') FOR CE
DO !b VALUES !c
  !!CE = !b.dbref()
  Q REF
  Q NAME
  Q XLEN
  XLEN 450
  Q XLEN
  OWNER
  Q REF
  Q NAME
ENDDO
SAVEWORK 'AIOS suite T3 ident/copyof_unit 2: BOX of the auto-named EQUI and of the Copy-of-inside EQUI resized'
$P SUITE-T3-COPYOF-UNIT-2-APPLY-DONE
ALPHA LOG END
