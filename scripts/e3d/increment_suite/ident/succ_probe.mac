-- 探针（只探不存）之七：复制接替要用的句子、容器改挂、无名子设备、删掉接着的引用目标。
-- 本文件**无 SAVEWORK**，改动随 wrapper 的 QUIT 丢弃。前置：ident/setup_t3.mac 已跑。
--
--  1  COPY 一条成员都有名字的支管：复制出来的成员叫什么（没名字 / Copy-of / 报重名）
--  2  COPY ... RENAME <旧前缀> <新前缀>：复制的同时把名字里的前缀换掉
--  3  RENAME ALL <旧前缀> <新前缀>：把一棵子树的名字前缀整体换掉
--  4  接替一口气做完：原件已让出名字 → 复制回原名 → 删原件
--  5  PIPE 整个改挂到另一个 ZONE（INCLUDE）：支管头的世界坐标跟不跟着变
--  6  ZONE 整个改挂到另一个 SITE
--  7  NEW SUBE：CE 在 SUBE 上再 NEW SUBE 是并列还是嵌套；SUBE <序号> 能不能导航；有名 BOX 在两个无名 SUBE 之间 INCLUDE
--  8  支管头接着管口时把支管删掉：管口的 CREF 是被清空还是留着旧值
ONERROR CONTINUE
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T3-SUCC-PROBE-ALIVE

$P T3-SUCC-1-COPY-NAMED-MEMBERS
/AIOS-SUITE-T3-BRAN-R
NEW BRAN /AIOS-SUITE-T3-BRAN-TMP
COPY /AIOS-SUITE-T3-BRAN-R
Q REF
Q NAME
Q MEMB

$P T3-SUCC-2-COPY-RENAME
/AIOS-SUITE-T3-BRAN-R
NEW BRAN COPY /AIOS-SUITE-T3-BRAN-R RENAME /AIOS-SUITE-T3-BRAN-R /AIOS-SUITE-T3-BRAN-Q
Q REF
Q NAME
Q MEMB

$P T3-SUCC-3-RENAME-ALL
/AIOS-SUITE-T3-BRAN-R
RENAME ALL /AIOS-SUITE-T3-BRAN-R /AIOS-SUITE-T3-BRAN-ROLD
Q REF
Q NAME
Q MEMB

$P T3-SUCC-4-SUCCESSION
NEW BRAN COPY /AIOS-SUITE-T3-BRAN-ROLD RENAME /AIOS-SUITE-T3-BRAN-ROLD /AIOS-SUITE-T3-BRAN-R
Q REF
Q NAME
Q MEMB
Q HPOS
Q TPOS
/AIOS-SUITE-T3-BRAN-ROLD
Q REF
Q HPOS
Q TPOS
DELETE BRAN
/AIOS-SUITE-T3-PIPE
Q MEMB

$P T3-SUCC-5-PIPE-TO-OTHER-ZONE
/AIOS-SUITE-T3-BRAN-R
Q HPOS
Q HPOS WRT /*
/AIOS-SUITE-T3-Z
NEW ZONE /AIOS-SUITE-T3-ZTMP
POS E 0 N 0 U 3000
Q REF
INCLUDE /AIOS-SUITE-T3-PIPE
Q MEMB
/AIOS-SUITE-T3-PIPE
Q OWNER
/AIOS-SUITE-T3-BRAN-R
Q HPOS
Q HPOS WRT /*

$P T3-SUCC-6-ZONE-TO-OTHER-SITE
{{WORLD_ANCHOR}}
NEW SITE /AIOS-SUITE-T3-STMP
Q REF
INCLUDE /AIOS-SUITE-T3-ZTMP
Q MEMB
/AIOS-SUITE-T3-ZTMP
Q OWNER
/AIOS-SUITE-T3
Q MEMB

$P T3-SUCC-7-SUBE
/AIOS-SUITE-T3-EQ-NZ
NEW SUBE
Q REF
Q OWNER
NEW SUBE
Q REF
Q OWNER
NEW BOX XLEN 100 YLEN 100 ZLEN 100
NAME /AIOS-SUITE-T3-BOX-TMPSUB
Q OWNER
/AIOS-SUITE-T3-EQ-NZ
Q MEMB
SUBE 1
Q REF
Q TYPE
INCLUDE /AIOS-SUITE-T3-BOX-TMPSUB
Q MEMB
/AIOS-SUITE-T3-BOX-TMPSUB
Q OWNER

$P T3-SUCC-8-DELETE-CONNECTED-TARGET
/AIOS-SUITE-T3-BRAN-R
Q REF
HREF /AIOS-SUITE-T3-NOZZ-1
Q HREF
/AIOS-SUITE-T3-NOZZ-1
Q CREF
/AIOS-SUITE-T3-BRAN-R
DELETE BRAN
/AIOS-SUITE-T3-NOZZ-1
Q CREF
/AIOS-SUITE-T3-EQ-NZ
Q CACHID

$P SUITE-T3-SUCC-PROBE-DONE
ALPHA LOG END
