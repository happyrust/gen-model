-- 登记: A02 | 语义: 删掉 EQ-RN2，在原位（EQ-M 之后）按基线重建 EQ-RN 和它的无名 BOX。refno 再换一次
-- expected_net: cancelled（按名回到基线） | restore 搭档: 本文件是 ident/recreate_renamed_apply.mac 的 restore
-- 幂等：EQ-RN 还在（apply 没跑）时先删掉再建，避免 Name already used 让宏崩在那一行。尺寸、位置与 ident/setup_t3.mac 同一组数。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T3-RECREATE-RENAMED-RESTORE-ALIVE
/AIOS-SUITE-T3-Z
Q REF
Q NAME
Q MEMB
VAR !tmp COLLECT ALL EQUIPMENT WITH (NAME EQ '/AIOS-SUITE-T3-EQ-RN2') FOR CE
DO !e VALUES !tmp
  !!CE = !e.dbref()
  Q REF
  Q NAME
  Q MEMB
  DELETE EQUI
ENDDO
/AIOS-SUITE-T3-Z
VAR !left COLLECT ALL EQUIPMENT WITH (NAME EQ '/AIOS-SUITE-T3-EQ-RN') FOR CE
DO !e VALUES !left
  !!CE = !e.dbref()
  DELETE EQUI
ENDDO
/AIOS-SUITE-T3-EQ-M
NEW EQUIPMENT /AIOS-SUITE-T3-EQ-RN
POS E 100000 N 32000 U 0
Q REF
Q NAME
NEW BOX XLEN 800 YLEN 400 ZLEN 300
Q REF
Q TYPE
Q OWNE
/AIOS-SUITE-T3-Z
Q MEMB
SAVEWORK 'AIOS suite T3 ident/recreate_renamed restore: EQ-RN2 deleted, EQ-RN recreated'
$P SUITE-T3-RECREATE-RENAMED-RESTORE-DONE
ALPHA LOG END
