-- 登记: A02 | 语义: 再删一次 BOX-M3，这次导航到 BOX-M2 再建，让它回到 M2 后面：成员序回到 M1, M2, M3。refno 又换一次
-- expected_net: cancelled（按名、按顺序都回到基线） | restore 搭档: 本文件是 ident/member_recreate_moved_apply.mac 的 restore
-- 尺寸、位置与 ident/setup_t3.mac 的 BOX-M3 同一组数。
ALPHA LOG "{{LOG_PATH}}" OVER
$P SUITE-T3-MEMBER-RECREATE-MOVED-RESTORE-ALIVE
/AIOS-SUITE-T3-EQ-M
Q REF
Q NAME
Q MEMB
VAR !old COLLECT ALL BOX WITH (NAME EQ '/AIOS-SUITE-T3-BOX-M3') FOR CE
DO !b VALUES !old
  !!CE = !b.dbref()
  Q REF
  Q NAME
  DELETE BOX
ENDDO
/AIOS-SUITE-T3-BOX-M2
NEW BOX XLEN 300 YLEN 300 ZLEN 300
NAME /AIOS-SUITE-T3-BOX-M3
POS E 3000 N 0 U 0
Q REF
Q NAME
Q OWNE
/AIOS-SUITE-T3-EQ-M
Q MEMB
SAVEWORK 'AIOS suite T3 ident/member_recreate_moved restore: BOX-M3 recreated after BOX-M2'
$P SUITE-T3-MEMBER-RECREATE-MOVED-RESTORE-DONE
ALPHA LOG END
