ALPHA LOG "{{LOG_PATH}}" OVER
$P AIOS-FIXTURE TEARDOWN BEGIN
={{WORLD_REFNO}}
VAR !fixtureSites COLLECT ALL SITE WITH (MATCHWILD(NAME, '/AIOS-INC-*')) FOR CE
DO !fixtureSite VALUES !fixtureSites
  !!CE = !fixtureSite.dbref()
  DELETE SITE
ENDDO
SAVEWORK 'AIOS fixture teardown'
$P AIOS-FIXTURE TEARDOWN DONE
ALPHA LOG END





