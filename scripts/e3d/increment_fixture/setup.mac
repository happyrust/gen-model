ALPHA LOG "{{LOG_PATH}}" OVER
$P AIOS-FIXTURE SETUP BEGIN WORLD={{WORLD_REFNO}}
={{WORLD_REFNO}}
VAR !fixtureSites COLLECT ALL SITE WITH (MATCHWILD(NAME, '/AIOS-INC-*')) FOR CE
DO !fixtureSite VALUES !fixtureSites
  !!CE = !fixtureSite.dbref()
  DELETE SITE
ENDDO

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-DATA
NEW ZONE /AIOS-INC-DATA-Z
NEW EQUIPMENT /AIOS-INC-DATA-EQ
DESC 'AIOS baseline'
NEW BOX XLEN 1000 YLEN 1000 ZLEN 1000
NAME /AIOS-INC-DATA-BOX

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-XFORM
NEW ZONE /AIOS-INC-XFORM-Z
NEW EQUIPMENT /AIOS-INC-XFORM-EQ
POS E 0 N 5000 U 0
NEW BOX XLEN 1000 YLEN 1200 ZLEN 1400
NAME /AIOS-INC-XFORM-BOX

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-GEOM
NEW ZONE /AIOS-INC-GEOM-Z
NEW EQUIPMENT /AIOS-INC-GEOM-EQ
POS E 5000 N 5000 U 0
NEW BOX XLEN 1000 YLEN 1000 ZLEN 1000
NAME /AIOS-INC-GEOM-BOX

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-BOOL
NEW ZONE /AIOS-INC-BOOL-Z
NEW EQUIPMENT /AIOS-INC-BOOL-EQ
POS E 10000 N 5000 U 0
NEW BOX XLEN 2000 YLEN 2000 ZLEN 2000
NAME /AIOS-INC-BOOL-BASE
NEW NBOX
XLEN 500
YLEN 500
ZLEN 2500
NAME /AIOS-INC-BOOL-NBOX

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-OWNER
NEW ZONE /AIOS-INC-OWNER-Z
!ownerZone = !!CE
NEW EQUIPMENT /AIOS-INC-OWNER-A
POS E 15000 N 5000 U 0
NEW BOX XLEN 800 YLEN 800 ZLEN 800
NAME /AIOS-INC-OWNER-BOX
!!CE = !ownerZone
NEW EQUIPMENT /AIOS-INC-OWNER-B
POS E 18000 N 5000 U 0

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-ADD
NEW ZONE /AIOS-INC-ADD-Z
NEW EQUIPMENT /AIOS-INC-ADD-EQ
POS E 22000 N 5000 U 0

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-DELETE
NEW ZONE /AIOS-INC-DELETE-Z
NEW EQUIPMENT /AIOS-INC-DELETE-EQ
POS E 26000 N 5000 U 0
NEW BOX XLEN 900 YLEN 900 ZLEN 900
NAME /AIOS-INC-DELETE-BOX

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-ROOM-STRUCT
NEW ZONE /AIOS-INC-ROOM-STRUCT-Z
NEW STRU /AIOS-INC-ROOM-STRU
!roomStructure = !!CE
NEW FRMW /AIOS-INC-RM-R101
NEW PANE /AIOS-INC-RM-R101-P1
NEW PLOO
HEIG 2000
NEW PAVE
POS E -2000 N -2000 U 0
NEW PAVE
POS E 2000 N -2000 U 0
NEW PAVE
POS E 2000 N 2000 U 0
NEW PAVE
POS E -2000 N 2000 U 0
!!CE = !roomStructure
NEW FRMW /AIOS-INC-RM-R102
NEW PANE /AIOS-INC-RM-R102-P1
NEW PLOO
HEIG 2000
NEW PAVE
POS E 8000 N -2000 U 0
NEW PAVE
POS E 12000 N -2000 U 0
NEW PAVE
POS E 12000 N 2000 U 0
NEW PAVE
POS E 8000 N 2000 U 0

={{WORLD_REFNO}}
NEW SITE /AIOS-INC-ROOM-MEMBER
NEW ZONE /AIOS-INC-ROOM-MEMBER-Z
NEW EQUIPMENT /AIOS-INC-ROOM-MEMBER-EQ
POS E 0 N 0 U 1000
NEW BOX XLEN 500 YLEN 500 ZLEN 500
NAME /AIOS-INC-ROOM-MEMBER-BOX

$P AIOS-FIXTURE OBJECTS BEGIN
={{WORLD_REFNO}}
VAR !createdSites COLLECT ALL SITE WITH (MATCHWILD(NAME, '/AIOS-INC-*')) FOR CE
DO !createdSite VALUES !createdSites
  !!CE = !createdSite.dbref()
  Q NAME
  Q REF
  Q TYPE
  Q OWNE
ENDDO
$P AIOS-FIXTURE OBJECTS DONE
SAVEWORK 'AIOS fixture baseline setup'
$P AIOS-FIXTURE SETUP DONE
ALPHA LOG END









