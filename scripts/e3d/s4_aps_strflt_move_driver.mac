-- 直接调 run_ams_c_entrymacro.bat 时的会话包装（l3_suite --check-driver 把 evar 钉在 AMS，进不了 APS）：
-- ALIVE 标记 → 场景宏 → DONE 标记 → QUIT。与 l3_suite 生成的 driver.mac 同构。
ALPHA LOG "D:/work/plant-code/old/gen-model-refactor/output/e3d-s4/aps_strflt_move_alive.log" OVER
$P S4-APS-ALIVE
ALPHA LOG END
$M "D:/work/plant-code/old/gen-model-refactor/scripts/e3d/s4_aps_strflt_move.mac"
ALPHA LOG "D:/work/plant-code/old/gen-model-refactor/output/e3d-s4/aps_strflt_move_done.log" OVER
$P S4-APS-DONE
ALPHA LOG END
QUIT
