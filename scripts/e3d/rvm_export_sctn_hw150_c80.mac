$(
------------------------------------------------------------------------
RVM 基准导出：ams7997 结构线的另外两个型材样本

  STRU /-RX-CAV-S9016      (SITE /1CAV-HVACHB → ZONE /-RX-CAV-9-HVAC-SUPP)
      → FRMW /-RX-CAV-S99016/MAIN → SCTN 24381/48838
        HW150X150X7X10 H 型钢，GTYP=BEAM，BANG=-90，JUSL=NA

  STRU /1TFA004MP-SUPP-01  (SITE /1TTU-INST23 → ZONE /1TFA-LX-SUPP)
      → FRMW /1TFA004MP-SUPP-01/FRMW-01 → SCTN /1TFA004MP-SUPP-01-BAR-1
        80 × 43 槽钢，GTYP=ANG，BANG=90，**JUSL=RTOS**

接 rvm_export_kx_cam_s4001.mac（那一份是 L40X4 等边角钢，BANG=-90、JUSL=NA，
逐顶点 0.0040 mm 对上）。这两个补的是它没覆盖的两条：

  - HW150 是 H 型钢，GMSS 里带一个没有 SPVE 的 CLFL 占位 SPRO 与一个
    TUFL=false 的 SPRO（`evidence/20260902-g11a-section-profiles` §3 记过），
    「逐成员求、空成员跳过」那条口径只有它能验；
  - C80 的 JUSL 是 RTOS 而不是 NA——截面要沿 p-line 平移之后才落到 SCTN
    局部系。BANG 与 JUSL 是 SCTN 标架仅有的两个自由度，S4001 只验了 BANG，
    这一根把 JUSL 补上。

表现口径与 rvm_export_1rx03_msup_e0110.mac 逐行相同。
导出是只读：没有 SAVEWORK，不产生新会话号。
------------------------------------------------------------------------
$)

ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/rvm_export_sctn_hw150_c80.log" OVER
$P CODEX-DB7997-HW150-C80-RVM-EXPORT-ALIVE

$* ---- 表现设置：只导实体几何 ----
repre insu off
repre obst off
repre tube on
export implied tube into separate containers

$* ---- 驱动与输出 ----
export system /expdri.so
export file "D:/work/plant-code/old/gen-model/test_data/rvm/SCTN-HW150-C80.rvm"
export filenote 'RVM baseline for STRU /-RX-CAV-S9016 (HW150) and /1TFA004MP-SUPP-01 (C80, JUSL RTOS), dbnum 7997'

$* ---- 表现选项 ----
export holes on
export autocolour displayexport on
export repr on

$* ---- 包含列表：两条 STRU 及其全部子孙 ----
export /-RX-CAV-S9016
export /1TFA004MP-SUPP-01

$* ---- 执行 ----
export finish

$P CODEX-DB7997-HW150-C80-RVM-EXPORT-DONE
ALPHA LOG END

$* ---- 自己收尾 ----
QUIT
FINISH
FINISH
