$)

ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/audit5/rvm_export_2664-M-OR-1RX-3051K.log" OVER
$P CODEX-AUDIT5-RVM-EXPORT-ALIVE
/M-OR-1RX-3051K
Q CE
Q REF
Q NAME
Q MEMB

repre insu off
repre obst off
repre tube on
export implied tube into separate containers

export system /expdri.so
export file "D:/work/plant-code/old/gen-model/output/rvm-audit5/2664-M-OR-1RX-3051K.rvm"
export filenote 'audit5 2664-M-OR-1RX-3051K: bracket route: 4 built r=12.5 tubes 1119mm'
export holes on
export autocolour displayexport on
export repr on
export /M-OR-1RX-3051K
export finish

$P CODEX-AUDIT5-RVM-EXPORT-DONE
ALPHA LOG END