$(
------------------------------------------------------------------------
RVM 导出（bran-audit §5 待定项复核，2026-09-02）：BRAN /M-CO-1RX-3051H  (dbnum 8000, =24384/2644)
挑它的理由：bracket route: 5 built r=12.5 tubes 850mm
窄口径同 rvm_export_1rcv0101_b1.mac：insu/obst off、tube on、隐含管段独立容器。
导出是只读动作：没有 SAVEWORK，不产生新会话号。不写 QUIT/FINISH——会话归 l3_suite driver。
------------------------------------------------------------------------
$)

ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/audit5/rvm_export_2644-M-CO-1RX-3051H.log" OVER
$P CODEX-AUDIT5-RVM-EXPORT-ALIVE
/M-CO-1RX-3051H
Q CE
Q REF
Q NAME
Q MEMB

repre insu off
repre obst off
repre tube on
export implied tube into separate containers

export system /expdri.so
export file "D:/work/plant-code/old/gen-model/output/rvm-audit5/2644-M-CO-1RX-3051H.rvm"
export filenote 'audit5 2644-M-CO-1RX-3051H: bracket route: 5 built r=12.5 tubes 850mm'
export holes on
export autocolour displayexport on
export repr on
export /M-CO-1RX-3051H
export finish

$P CODEX-AUDIT5-RVM-EXPORT-DONE
ALPHA LOG END