$(
------------------------------------------------------------------------
RVM 导出（bran-audit §5 待定项复核，2026-09-02）：BRAN /M-YE-1R320-C  (dbnum 8000, =24384/23903)
挑它的理由：backtrack 178deg r=30.15 60.6mm between members
窄口径同 rvm_export_1rcv0101_b1.mac：insu/obst off、tube on、隐含管段独立容器。
导出是只读动作：没有 SAVEWORK，不产生新会话号。不写 QUIT/FINISH——会话归 l3_suite driver。
------------------------------------------------------------------------
$)

ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/audit5/rvm_export_23903-M-YE-1R320-C.log" OVER
$P CODEX-AUDIT5-RVM-EXPORT-ALIVE
/M-YE-1R320-C
Q CE
Q REF
Q NAME
Q MEMB

repre insu off
repre obst off
repre tube on
export implied tube into separate containers

export system /expdri.so
export file "D:/work/plant-code/old/gen-model/output/rvm-audit5/23903-M-YE-1R320-C.rvm"
export filenote 'audit5 23903-M-YE-1R320-C: backtrack 178deg r=30.15 60.6mm between members'
export holes on
export autocolour displayexport on
export repr on
export /M-YE-1R320-C
export finish

$P CODEX-AUDIT5-RVM-EXPORT-DONE
ALPHA LOG END