$(
------------------------------------------------------------------------
RVM 导出（HDIR/TDIR 朝向约定 + 对齐阈值边界复核，2026-09-02）：BRAN /M-CO-1R312-G  (dbnum 8000, =24384/24758)
挑它的理由：tail tube 200mm r=10.65 leave 0.00deg
窄口径同 rvm_export_1rcv0101_b1.mac。只读：没有 SAVEWORK；不写 QUIT/FINISH——会话归 l3_suite driver。
------------------------------------------------------------------------
$)

ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/audit5/rvm_export_24758-M-CO-1R312-G.log" OVER
$P CODEX-AUDIT5-RVM-EXPORT-ALIVE
/M-CO-1R312-G
Q CE
Q REF
Q NAME
Q HPOS
Q HDIR
Q TPOS
Q TDIR
Q MEMB

repre insu off
repre obst off
repre tube on
export implied tube into separate containers

export system /expdri.so
export file "D:/work/plant-code/old/gen-model/output/rvm-audit5/24758-M-CO-1R312-G.rvm"
export filenote 'audit5 24758-M-CO-1R312-G: tail tube 200mm r=10.65 leave 0.00deg'
export holes on
export autocolour displayexport on
export repr on
export /M-CO-1R312-G
export finish

$P CODEX-AUDIT5-RVM-EXPORT-DONE
ALPHA LOG END