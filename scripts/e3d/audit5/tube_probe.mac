ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/audit5/tube_probe.log" OVER
$P CODEX-AUDIT5-TUBE-PROBE-ALIVE

do !bran values |/C-GR-1RX-3020B| |/Copy-of-1RCV0101-60.3-VMB-R90-R332]R333| |/C-GR-1RX-3000A| |/M-YE-1R320-C|
