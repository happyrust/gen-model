-- L2 回放链 ams8000-equi-move-chain：EQUI /1-LNR-Q005-PJ (=24384/24776, dbnum 8000) 整根上 500 mm（刚体路）。
-- 恰好一个 SAVEWORK；wrapper QUIT。
ONERROR CONTINUE
ALPHA LOG "D:/work/plant-code/old/gen-model/output/replay-record/equi_apply.log" OVER
$P REPLAY-APPLY-ALIVE
=24384/24776
Q NAME
Q REF
Q POS
BY U 500mm
