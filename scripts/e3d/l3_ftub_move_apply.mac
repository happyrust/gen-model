-- F6 / D-02: INCLUDE moves an existing element into the current owner's member list.

ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/l3_ftub_move_apply.log" OVER
$P L3-F6-ALIVE
=24384/22404
INCLUDE =24384/22403
=24384/22403
Q CE
Q OWNE
SAVEWORK 'L3 F6 move FTUB 24384/22403 to BRAN 24384/22404'
$P L3-F6-DONE
ALPHA LOG END
