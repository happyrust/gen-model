-- 通风增量 H-01「改·几何参数」restore：把 DAMP /1CUP001VAR (24381/100819) 的 DESP NUM2 写回基线 1000。
--
-- 只写 apply 动过的那一个标量（NUM2 = 1000，2026-09-06 由 aios_db.parse.element 对 ams7997_0001@106
-- 的 explicit_attrs.DESP 读到的绝对基线值），不是反向增量。
--
-- 为什么不整条 90 值重写：`DESPAR NUMn <值>` 会把该槽的单位标签（UNIPAR）按「当前默认单位」重打；
-- 基线里 10 个存 hash 的槽（NUM1/30/32/40/50/58/59/66/67/88）标的是 623723（无单位/字），整条重写会
-- 把它们全改成 640481（距离），几何一字不差、DESP 值一字不差，却在合并窗口留下一条 UNIPAR 业务残差
-- （2026-09-06 首跑实测：full@106==full@108 逐件 0 差，但 merged 106→108 多一条 DAMP UNIPAR）。
-- 只写变过的 NUM2（它本来就是 640481）就不碰其余 89 槽的单位标签，合并窗口只剩 CACHID。
-- 完整 90 值基线留档在 output/hvac-100817-increment/<ts>/hvac_100817_damp_desp_restore.full90.mac.bak
-- 与 baseline-elements-106.json，需要时可查。
--
-- 纪律同 db8000_bran_scratch_*：恰好一个 SAVEWORK；不写 QUIT/FINISH；SAVEWORK 之前先导窄口径 RVM。
-- ATTLIST 不在宏内做（首跑崩在逐属性 Q 上），属性对拍由只读的 e3d_tty_attlist_capture 另开会话完成。

ALPHA LOG "D:/work/plant-code/old/gen-model/scripts/e3d/hvac_100817_damp_desp_restore.log" OVER
$P CODEX-HVAC-100817-DESP-RESTORE-ALIVE
=24381/100819
Q CE
Q REF
Q NAME
Q OWNE
Q DESP
DESPAR NUM2 1000
Q DESP

$* ---- RVM 导出（状态 h01-desp-restored，SAVEWORK 之前）----
repre insu off
repre obst off
repre tube on
repre lev hvac 6
export implied tube into separate containers
Q REPRE
export system /expdri.so
export file "D:/work/plant-code/old/gen-model/output/hvac-100817-increment/rvm/h01-desp-restored.rvm"
export filenote 'CODEX hvac 100817 H-01 restore: DAMP /1CUP001VAR DESP NUM2 back to 1000'
export holes on
export autocolour displayexport on
export repr on
export /-CUP-S-3-M-1201
export finish

=24381/100819
Q REF
Q DESP
SAVEWORK 'CODEX hvac 100817 H-01 restore: DAMP /1CUP001VAR DESP NUM2 1400 to 1000'
$P CODEX-HVAC-100817-DESP-RESTORE-DONE
ALPHA LOG END
