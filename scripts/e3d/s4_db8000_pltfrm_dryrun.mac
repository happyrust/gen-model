-- S4 造窗 · P23 替身 PLTFRM 建法的分段试探（**无 SAVEWORK**，末尾 DELETE，QUIT 时不落盘）。
-- HRPOST 字典里没有 POS / ORI（摆放由 POSREF + ZDIS/XOFF 派生），造不出「只动了摆放」的窗；
-- P23 里带 POS/ORI 又能在 db8000 从零造出来的，先试 PLTFRM（平台，IPFCOM 族）：STRU 之下建 PLTFRM，PLTFRM 之下建 PANE。

ALPHA LOG "D:/work/plant-code/old/gen-model-refactor/output/e3d-s4/pltfrm_dryrun_1_start.log" OVER
$P CODEX-S4-PLTFRM-DRYRUN-START
/1RX03-MSUP-E0001
Q CE
Q REF
ALPHA LOG END

NEW PLTFRM /CODEX_S4_DRY_PLTFRM
ALPHA LOG "D:/work/plant-code/old/gen-model-refactor/output/e3d-s4/pltfrm_dryrun_2_pltfrm.log" OVER
$P CODEX-S4-PLTFRM-DRYRUN-PLTFRM-CREATED
Q CE
Q REF
Q OWNE
Q ATT
ALPHA LOG END

POS E 0 N 0 U 6000
ALPHA LOG "D:/work/plant-code/old/gen-model-refactor/output/e3d-s4/pltfrm_dryrun_3_pos.log" OVER
$P CODEX-S4-PLTFRM-DRYRUN-PLTFRM-POSITIONED
Q POS
Q ORI
ALPHA LOG END

NEW PANE /CODEX_S4_DRY_PLT_PANE
POS E 0 N 0 U 0
NEW PLOO
HEIG 12
NEW PAVE
POS E 0 N 0 U 0
NEW PAVE
POS E 2000 N 0 U 0
NEW PAVE
POS E 2000 N 1000 U 0
NEW PAVE
POS E 0 N 1000 U 0
ALPHA LOG "D:/work/plant-code/old/gen-model-refactor/output/e3d-s4/pltfrm_dryrun_4_pane.log" OVER
$P CODEX-S4-PLTFRM-DRYRUN-PANE-CREATED
Q CE
Q REF
Q OWNE
/CODEX_S4_DRY_PLT_PANE
Q OWNE
Q MEMBERS
/CODEX_S4_DRY_PLTFRM
Q MEMBERS
ALPHA LOG END

/CODEX_S4_DRY_PLTFRM
DELETE PLTFRM
ALPHA LOG "D:/work/plant-code/old/gen-model-refactor/output/e3d-s4/pltfrm_dryrun_5_deleted.log" OVER
$P CODEX-S4-PLTFRM-DRYRUN-DELETED-NO-SAVE
Q CE
ALPHA LOG END
