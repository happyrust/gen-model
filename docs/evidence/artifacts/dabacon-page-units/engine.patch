+            page_size_words: read_u32(0x34),
             stored_page_count: read_u32(0x38),
         })
     }
+
+    pub fn page_size_bytes(&self) -> Result<usize, EngineError> {
+        let words = usize::try_from(self.page_size_words)
+            .map_err(|_| EngineError::Format("页长 word 数超出平台范围".into()))?;
+        words
+            .checked_mul(size_of::<u32>())
+            .filter(|bytes| *bytes > 0)
+            .ok_or_else(|| EngineError::Format("文件头 0x34 的页长 word 数无效".into()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::HeaderView;
+
+    #[test]
+    fn header_page_length_is_stored_in_u32_words() {
+        let mut header = [0u8; 64];
+        header[0x34..0x38].copy_from_slice(&512u32.to_be_bytes());
+
+        let parsed = HeaderView::from_bytes(&header).unwrap();
+
+        assert_eq!(parsed.page_size_words, 512);
+        assert_eq!(parsed.page_size_bytes().unwrap(), 2048);
+    }
 }
 
