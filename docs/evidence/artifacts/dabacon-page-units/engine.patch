     pub latest_ses_pgno: u32,
     pub ext_no: u32,
     pub session_page_no: u32,
-    pub page_size: u32,
+    /// Physical page length stored as a count of 32-bit words.
+    ///
+    /// `core.dll` converts this value to bytes by multiplying by four. The
+    /// normal value is therefore 512 words, or 2048 bytes.
+    pub page_size_words: u32,
     pub stored_page_count: u32,
