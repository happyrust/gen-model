  <diagram name="③ 一致性与容错">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3band1" value="正常时序（单文件 apply_one）" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="780" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="① 门控 + F6 文件身份校验&#xa;record_scan 只写观察字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="p3band1">
          <mxGeometry x="40" y="60" width="700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="② prepare_attempt&#xa;写 increment_update_attempt：固定 range + 模型计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p3band1">
          <mxGeometry x="40" y="190" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="③ persist_latest_main_data&#xa;分块事务 chunk=500 · UPSERT 幂等 · 只写 pe 最新态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="p3band1">
          <mxGeometry x="40" y="330" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="④ maintain_reverse_index / datacenter_version&#xa;（按约定非致命）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="p3band1">
          <mxGeometry x="40" y="470" width="700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="⑤ finalize_attempt【单事务】&#xa;入队 ModelWorkItem + 推进 applied_sesno + 删恢复记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="p3band1">
          <mxGeometry x="40" y="600" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="⑥ model_update_pending::drain&#xa;执行 RegenRoot / Transform / DeleteCleanup / CascadeExpand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="p3band1">
          <mxGeometry x="40" y="750" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="⑦ 下游副作用&#xa;MySQL / SYST 派生 / MQTT 异地同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="p3band1">
          <mxGeometry x="40" y="890" width="700" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3band2" value="崩溃 / 异常 → 恢复策略" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="60" width="1000" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="文件回退（file_latest &lt; applied）/ 同 dbnum 多个文件&#xa;→ 阻断该文件，水位绝不回退，也不自动挑选文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p3band2">
          <mxGeometry x="40" y="60" width="920" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="崩在 ②~⑤ 之间&#xa;→ attempt 记录仍在、水位未动 → 下次复用「固定窗口 + 落库前算好的旧计划」原样重放&#xa;（PE 可能半写，更新后的 OWNER 图已不可信，所以不重算计划）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p3band2">
          <mxGeometry x="40" y="190" width="920" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="落库事务失败 / 半写&#xa;→ 水位不推进；UPSERT 幂等使同一窗口重放从可收敛状态开始&#xa;（避免「半写 + 重试撞已存在记录」把 dbnum 水位卡死）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p3band2">
          <mxGeometry x="40" y="330" width="920" height="110" as="geometry" />
        </mxCell>
        <mxCell id="crev" value="反向索引 / datacenter 写失败&#xa;→ 只记 warning，绝不阻塞数据批次与水位；缺一条引用边最多漏一次级联，靠后续触及或全量重建自愈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="p3band2">
          <mxGeometry x="40" y="470" width="920" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="崩在 ⑤ 之后、模型执行之前&#xa;→ 水位已推进，但工作项已在 model_update_pending 落库 → 下次 drain 照常补做（不需要重放数据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="p3band2">
          <mxGeometry x="40" y="600" width="920" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="模型生成失败&#xa;→ status = failed，attempts + 1，记 last_error；下次 watcher / 手动触发时 drain 重试，水位不回退&#xa;（另有 conservative_regen 失败 → owner_regen 粗粒度安全超集兜底）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p3band2">
          <mxGeometry x="40" y="750" width="920" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="下游副作用失败（MySQL / SYST 派生 / MQTT）&#xa;→ 记 warning + SideEffectCompensator 落库待补偿，启动时与每次事件前 drain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="p3band2">
          <mxGeometry x="40" y="890" width="920" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3inv" value="核心不变式（ADR-001）&#xa;① applied_sesno 只在「该 dbnum 的数据批次整体成功」后推进，绝不回退、绝不虚增&#xa;② 文件观察字段（file_latest_sesno / scanned_at / 文件身份）与 applied_sesno 分开写：观察写失败不得影响水位&#xa;③ 模型工作计划在落库前算好并持久化，使「数据成功、模型没做完」可安全重放&#xa;④ 模型生成与下游同步失败都不回滚水位，改由持久队列 + 补偿器重试；逻辑窗口恒为 (applied_sesno, file_latest_sesno]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=20;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1130" width="1860" height="190" as="geometry" />
        </mxCell>

