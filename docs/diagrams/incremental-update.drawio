  <diagram name="② 影响判定与生成根归一">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2_in" value="EleOperationData（一次元素操作，来自某个 sesno）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_d1" value="detail 类型？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="170" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_add" value="Add / Deleted&#xa;→ 直接 Regen（StructuralMembership）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="340" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_mod" value="Modified&#xa;→ 逐属性归类 classify_operation_effects&#xa;（children 变化 / 属性差异为空 也保守 Regen）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="340" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_none" value="None&#xa;→ Skip（无操作）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="340" width="380" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2band" value="属性效果分类 model_impact::classify_attribute_effect_with_meta —— 宁多勿漏：只有明确中性才跳过" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="1660" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p2_egeo" value="DirectGeometry → Regen&#xa;DIAM / XLEN / HEIG / RADI / PARA* / P-point 参数&#xa;（直接几何输入，改了就重建网格）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p2band">
          <mxGeometry x="40" y="60" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_edep" value="DependencyCascade → Regen + 反查级联&#xa;SPRE / CATR / PRTREF / HREF / DESP …&#xa;（经目录、规格、邻居间接影响几何）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p2band">
          <mxGeometry x="580" y="60" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_estr" value="StructuralMembership → Regen&#xa;OWNER / CHILDREN / NOUN / TYPE / LEVE&#xa;（OWNER 搬迁：新旧两侧生成根都要重建）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p2band">
          <mxGeometry x="1120" y="60" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_eunk" value="Unknown → Regen（保守）&#xa;静态清单未覆盖的属性、UDA:&lt;id&gt;&#xa;A2：若 att_type = ELEMENT（引用属性）则升级为 DependencyCascade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="p2band">
          <mxGeometry x="40" y="190" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_etrans" value="TransformOnly → 仅更新 world transform&#xa;POS / POSL / ORI / YDIR / ZDIR …&#xa;例外：noun 是 loop 容器（POIN/VERT/PAVE/PLOO）→ 升级 Regen&#xa;（点坐标是属主网格的输入，不是独立实例位姿）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p2band">
          <mxGeometry x="580" y="190" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_edata" value="DataOnly → Skip&#xa;NAME / DESC / PURP / FUNCTION&#xa;（纯业务元数据，落库但不动几何）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="p2band">
          <mxGeometry x="1120" y="190" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2_impact" value="归约三态 OperationEffectSummary::impact()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
