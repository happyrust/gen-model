          <mxGeometry x="200" y="1030" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_trans" value="TransformOnly&#xa;只更新 world transform，网格不变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="1030" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_skip" value="Skip&#xa;不做模型工作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1030" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p2_net" value="净变化折叠 merge_net_change_details（整个待更新窗口按 refno 合并）&#xa;新增后修改 → Added ｜ 多次修改 → Modified ｜ 修改后删除 → Deleted ｜ 新增后删除 → Cancelled（丢弃，不产生任何工作）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="1170" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_revfail" value="反向索引读失败 → 降级&#xa;resolve_unit_rollup_without_reverse_index&#xa;并为每个受影响元素登记 CascadeExpand 待办" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="1170" width="460" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2band15" value="交付单元归并 manual_update::resolve_unit_rollup —— 三源合一后再按生成根策略归一（ADR-003）" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="1330" width="1560" height="320" as="geometry" />
        </mxCell>
        <mxCell id="p2r1" value="① load_base_graph&#xa;落库前的 Surreal PE / OWNER 链&#xa;计划在写库前算，所以它就是前态快照（含本窗口将删除的元素）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p2band15">
          <mxGeometry x="30" y="50" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2r2" value="② build_owner_overlay&#xa;窗口内 Add / Modified 的后态 OWNER 覆盖图&#xa;（含同窗口一起搬迁的祖先）+ 净删除集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p2band15">
          <mxGeometry x="540" y="50" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2r3" value="③ load_ref_reversal_closure&#xa;ref_rev 反向引用的传递闭包（有界 BFS）&#xa;穿透 SPCO / SCOM 这类自身没有交付单元的目录中间件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="p2band15">
          <mxGeometry x="1050" y="50" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2r4" value="build_unit_rollup：增 / 改按后态解析，删按前态解析&#xa;· 跨单元搬迁 → 旧单元记 moved_out、新单元记 moved_in，两侧都重生成&#xa;· 反向级联 → 被引用元素变更时，所有引用者所在交付单元一并 cascaded（目录链 TABITE → SPCO → BRAN 逐跳跟进）&#xa;· 没有交付单元祖先 → 计入 no_generation + warning；不做整 ZONE 兜底，也不阻塞数据批次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=24;" vertex="1" parent="p2band15">
          <mxGeometry x="30" y="200" width="1500" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p2band2" value="生成根归一 generation_root.rs —— 一个变化元素 → 恰好一个生成根；同一根一批只生成一次" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="1720" width="1000" height="340" as="geometry" />
        </mxCell>
        <mxCell id="p2_g1" value="① 最近的最小交付单元（MDU）祖先&#xa;默认 BRAN / HANG / SUPPO / EQUI&#xa;可用 delivery_unit_types 配置替换/追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p2band2">
          <mxGeometry x="30" y="60" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_g2" value="② 无 MDU → significant owner&#xa;上溯 owner；跨 loop 容器&#xa;(LOOP/PLOO/VERT/PAVE) 继续上溯，≤32 层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p2band2">
          <mxGeometry x="510" y="60" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_g3" value="③ owner 为 SITE / ZONE（颗粒过粗）&#xa;→ 改用元素自身作根（如 EQUI / PIPE / STRU）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="p2band2">
