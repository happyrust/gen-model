        </mxCell>
        <mxCell id="p2_g4" value="④ 元素自身即 SITE / ZONE / WORL&#xa;→ 不生成（绝不整区重算）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="p2band2">
