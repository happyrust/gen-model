  </diagram>

  <diagram name="④ 模型工作队列 · 重试 · 死信">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p4title" value="model_update_pending：数据与模型解耦后的重试队列" style="text;html=1;whiteSpace=wrap;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p4n1" value="入队：finalize_attempt / finalize_baseline 的同一个事务里 UPSERT&#xa;record_id = {dbnum}_{action}_{target_refno}&#xa;同一个 (dbnum, action, 目标) 永远只有一行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4n2" value="死信复活语义（render_upsert）&#xa;end_sesno &gt; source_end_sesno（来了新会话）→ attempts 归零、last_error 清空&#xa;同会话重复展开 → attempts 保持不变，不会误复活&#xa;三条 SET 子句的相对顺序是功能性的，已有专门测试钉住" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4n3" value="派生根按自身所属设计库记账&#xa;dbnum = 根自己的库，source_end_sesno = 0&#xa;（会话号是按库编号的，挂目录库的 sesno 会永久卡住复活）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1220" y="70" width="540" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p4n4" value="drain(mgr)：先非重生成、后重生成&#xa;级联展开本身会入队新的 RegenRoot，所以必须先跑完它" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4n5" value="① drain_non_regen&#xa;action ∈ [transform, delete_cleanup, cascade_expand]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4n6" value="② drain_where(action = 'regen_root')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4n7" value="选取条件&#xa;status ∈ ['pending','failed'] AND (attempts ?: 0) &lt; MAX_ATTEMPTS(5)&#xa;ORDER BY updated_at ASC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="350" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4n8" value="批处理：attempts = 0 且 refno 可解析的根合成一批，&#xa;一次 generate_roots 走完解析→实例→网格；&#xa;整批失败则回退逐根重跑，定位到具体的坏根。&#xa;重试过的根 / 不可解析的根始终单独跑。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4n9" value="run_one 刻意不可失败&#xa;单个目标失败（含删不掉队列行）只记 mark_failed，&#xa;不中断整轮 —— 否则一次抖动的 DELETE 会跳过后面所有 dbnum，&#xa;而刚生成成功的那个根下一轮还要再全量生成一次。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="470" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4n10" value="attempts ≥ 5 → 死信&#xa;自动路径不再取用；手动预览与 GET /update/pending-units 仍可见；&#xa;等到该目标所在库出现新会话时自动复活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1160" y="350" width="600" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p4n11" value="执行端（execute_item）" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4x1" value="RegenRoot&#xa;ModelRefreshPolicy::generate_roots&#xa;→ gen_all_geos_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="p4n11">
          <mxGeometry x="30" y="54" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4x2" value="Transform&#xa;update_world_transforms&#xa;（网格不变，只刷位姿）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="p4n11">
          <mxGeometry x="460" y="54" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4x3" value="DeleteCleanup&#xa;delete_inst_relate_subtree&#xa;每个 refno 的删边与 inst_info 引用计数回收同处一个事务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="p4n11">
          <mxGeometry x="890" y="54" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4x4" value="CascadeExpand&#xa;expand_live_reverse_cascade&#xa;实时查 ref_rev，把派生根幂等入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="p4n11">
          <mxGeometry x="1320" y="54" width="370" height="95" as="geometry" />
        </mxCell>

        <mxCell id="p4n12" value="手动路径的收口&#xa;worklist = 本轮新单元 ∪ load_pending_model_units_for_retry()&#xa;后者同时读 legacy manual_model_pending 与 model_update_pending 的 regen_root，&#xa;两侧都带 attempts &lt; 5 门槛；新的失败只写 model_update_pending 一处。&#xa;成功后同时清 manual_model_pending 行与 model_update_pending 行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="840" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4n13" value="调用时机&#xa;• init_watcher 启动补偿一次&#xa;• async_watch 启动一次 + 每个文件变更事件前一次&#xa;• execute_incr_update 末尾一次（失败只进 warnings，不回滚水位）&#xa;• 手动执行：只 drain_non_regen，重生成走自己的 worklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="830" width="840" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p4f" value="本页相关审核发现&#xa;F6（低）死信没有主动告警出口：attempts 满 5 后从自动路径彻底消失，只能靠有人主动看预览或 /update/pending-units 才会发现。建议 drain 结束时把死信条数打进日志与 WS 摘要。&#xa;F7（低）drain 一次性 SELECT 全表待办，没有 LIMIT：一次大规模删除会把上万行一次性拉进内存再逐条串行跑完。&#xa;F8（低）自动路径的 MySQL 同步失败只 println，既不进 IncrResult.warnings 也不入补偿队列 —— 相邻的 SYST 派生同步两样都做了。SurrealDB 与 MySQL 就此静默分叉。&#xa;F9（提示）两个项目同时手动执行时，各自的 ProjectExecGuard 只锁自己，但 drain_non_regen 是全局的：A 项目的运行会顺带消费 B 项目的级联/位姿工作。目前幂等，不算缺陷，但边界值得写明。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1720" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p4e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4n1" target="p4n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4n4" target="p4n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4n5" target="p4n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="p4n5" target="p4n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4n6" target="p4n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4n7" target="p4n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4n8" target="p4n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4n8" target="p4n11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
