          </mxGeometry>
        </mxCell>
        <mxCell id="p2_x20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a6" target="p2_a7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_x21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a7" target="p2_e1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_x22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a7" target="p2_a8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_x23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a8" target="p2_e2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_x24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a8" target="p2_a9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_x25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a9" target="p2_a10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_x26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a10" target="p2_a11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_x27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_a11" target="p2_a12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3-存储职责与收口就绪门">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3_title" value="存储职责边界、locator 三段发布协议与就绪门" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="-50" width="880" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p3_s1" value="&lt;b&gt;SurrealDB · 完整元素数据（权威）&lt;/b&gt;&lt;br&gt;&lt;br&gt;pe — 元素主记录&lt;br&gt;pe_owner — owner 关系边&lt;br&gt;ATT_{noun} — 按 noun 分表的属性&lt;br&gt;ATT_UDA — 用户自定义属性&lt;br&gt;dbnum_info_table — 每库元素计数&lt;br&gt;dbnum_watermark — applied_sesno&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ hierarchy_release_id + locator_hash&lt;br&gt;model_update_pending — 待重试模型任务&lt;br&gt;&lt;br&gt;写入方式：解析期间流式并发写，&lt;br&gt;分批事务，一批失败不回滚已写数据&lt;br&gt;（正确性由水位兜底）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="420" height="420" as="geometry" />
        </mxCell>

        <mxCell id="p3_s2" value="&lt;b&gt;DuckLake · 当前态层级（唯一权威）&lt;/b&gt;&lt;br&gt;&lt;br&gt;hierarchy_node（按 dbnum 分区）&lt;br&gt;&amp;nbsp;&amp;nbsp;dbnum / refno / owner / noun&lt;br&gt;&amp;nbsp;&amp;nbsp;/ name / sibling_order&lt;br&gt;&lt;br&gt;hierarchy_release&lt;br&gt;&amp;nbsp;&amp;nbsp;release_id / base_release_id&lt;br&gt;&amp;nbsp;&amp;nbsp;start_sesno / end_sesno&lt;br&gt;&amp;nbsp;&amp;nbsp;source_digest / change_hash&lt;br&gt;&amp;nbsp;&amp;nbsp;locator_hash / row_count&lt;br&gt;&lt;br&gt;每次发布 = 一个 DuckLake snapshot，&lt;br&gt;commit_message 就是 release_id。&lt;br&gt;DuckDB ducklake 扩展 SHA256 硬编码钉版。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="420" height="420" as="geometry" />
        </mxCell>

        <mxCell id="p3_s3" value="&lt;b&gt;kv-mem · 可丢弃缓存&lt;/b&gt;&lt;br&gt;&lt;br&gt;每个 dbnum 一个独立的进程内嵌&lt;br&gt;SurrealDB 内存实例，装载该库全部&lt;br&gt;层级行，建 owner / noun 两个索引。&lt;br&gt;&lt;br&gt;首次查询冷加载（2000 行一批），&lt;br&gt;per-dbnum load gate 串行化。&lt;br&gt;&lt;br&gt;sync 失败或 release 对不上 →&lt;br&gt;直接驱逐分片，下次查询重新冷加载。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;目前无淘汰策略，只增不减；&lt;br&gt;规格要求的 RSS 观测也未落地。&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="60" width="420" height="420" as="geometry" />
        </mxCell>

        <mxCell id="p3_s4" value="&lt;b&gt;locator · 内容寻址文件&lt;/b&gt;&lt;br&gt;&lt;br&gt;用途：ref0 → dbnum 反查，&lt;br&gt;以及跨库 owner 路由&lt;br&gt;（external_owner_routes）。&lt;br&gt;&lt;br&gt;staged：内容哈希命名，已落盘未激活&lt;br&gt;active_locator.json：激活指针&lt;br&gt;&lt;br&gt;发布与激活分离，是为了让&lt;br&gt;「DuckLake 已提交、水位还没写」&lt;br&gt;这个中间态不对读侧可见。&lt;br&gt;&lt;br&gt;每次查找目前都走 spawn_blocking，&lt;br&gt;整改方案建议换进程内快照。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="60" width="420" height="420" as="geometry" />
        </mxCell>

        <mxCell id="p3_ph" value="locator 三段发布协议（仅在需要全量解析时启用）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3_p1" value="begin_baseline_locator_publication(dbnum)&#xa;取 hierarchy_publication_guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_p2" value="全量解析 + publish_baseline&#xa;stage_locator：落盘但不激活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="580" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_p3" value="bind_baseline_locator_publication&#xa;(dbnum, release_id, locator_hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="580" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_p4" value="finalize_baseline_with_hierarchy&#xa;单事务收口（见下）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1150" y="580" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_p5" value="finish_locator_publication&#xa;激活 active_locator，读侧才看得见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1520" y="580" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3_y1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_p1" target="p3_p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_y2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_p2" target="p3_p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_y3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_p3" target="p3_p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_y4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_p4" target="p3_p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p3_tx" value="&lt;b&gt;收口事务（唯一推进水位的地方）&lt;/b&gt;&lt;br&gt;render_watermark_advance 只出现在这两个函数里：&lt;br&gt;finalize_baseline_with_hierarchy / finalize_attempt_with_hierarchy&lt;br&gt;&lt;br&gt;同一事务内三件事同时成立：&lt;br&gt;1) 写 model_update_pending 工作项&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;（按 (action, target_refno) 去重，靠 revision 收口）&lt;br&gt;2) UPSERT dbnum_watermark.applied_sesno&lt;br&gt;3) 写 hierarchy_release_id + locator_hash&lt;br&gt;&lt;br&gt;任一失败 → 整体不推进，下一轮从头重来。&lt;br&gt;推进条件是「数据已落库 且 模型工作已持久化」，&lt;br&gt;不要求模型真的生成完。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="600" height="330" as="geometry" />
        </mxCell>

        <mxCell id="p3_gate" value="readiness 门&#xa;applied_sesno 与 hierarchy_release_id&#xa;是否都与 DuckLake 当前 release 对上 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="800" width="440" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p3_ok" value="放行&#xa;分片冷加载 → 当前态层级查询&#xa;get_many / ordered_children&#xa;/ refnos_by_nouns / descendants_inclusive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="760" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_no" value="fail-closed&#xa;hierarchy dbnum is not ready&#xa;不回退旧持久查询&#xa;（回退会让生成观察到混合 release）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="930" width="400" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p3_y5" value="就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_gate" target="p3_ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_y6" value="未就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontFamily=Microsoft YaHei;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_gate" target="p3_no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_y7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_tx" target="p3_gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p3_note" value="&lt;b&gt;几条容易踩的结论&lt;/b&gt;&lt;br&gt;· sync_pdms 发布 DuckLake baseline，但&lt;b&gt;不写水位&lt;/b&gt;：跑完全量同步系统仍然不「就绪」。&lt;br&gt;· 更进一步，&lt;b&gt;独立跑 sync_pdms 基本白费&lt;/b&gt;——applied_sesno 仍为 0，会让 baseline_needs_full_parse 再解析一遍（幂等，只是白花时间）。正确做法是不手动开 total_sync，让基线路径自己驱动那次受限解析。&lt;br&gt;· SYS meta（SYST / DICT / GLB / GLOB）&lt;b&gt;也走基线&lt;/b&gt;，不走 cold-start 重放：两条路用的不是同一个解析器，ADR-006 的跨块引用（CURD / DBLS）修复只落在 parse_pdms_db 上。&lt;br&gt;· 连带后果：UpdateScope 本身是从 SYS meta 库读出来的，所以 SYS 必须先建基线，DESI 才进得了执行范围——batch_worker 的 SCOPE_DIRTY 标志就是处理这件事的。&lt;br&gt;· readiness 不只是性能负担，它同时是「PE 已落、DuckLake 未提交」这个崩溃窗口的&lt;b&gt;唯一防线&lt;/b&gt;，优化时只能换粒度、不能拿掉。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;dashed=1;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1800" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
