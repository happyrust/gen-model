<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="1-总览 数据解析到模型生成">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1_title" value="aios-database 数据解析总流程：从触发到模型生成" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="260" y="-40" width="840" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p1_t1" value="HTTP&#xa;POST /api/v1/update/execute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1_t2" value="文件监听&#xa;init_watcher / async_watch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="40" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1_t3" value="CLI / bin&#xa;initialize_project_dbnum_baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="40" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p1_n1" value="扫描候选 FileCandidate&#xa;（file_latest_sesno = 扫描观察值）&#xa;→ 入队 batch_queue（合并 / 冻结区间 / FIFO）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="180" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_n2" value="batch_worker（全局唯一消费者）&#xa;execute_one_dbnum(project, cand)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="330" width="420" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p1_d1" value="needs_initial_load ?&#xa;applied_sesno == 0&#xa;且 file_latest_sesno &gt; 0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="480" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p1_inc1" value="增量窗口分支&#xa;开区间 (applied_sesno, file_latest_sesno]&#xa;IncrementPipeline::apply(ranges)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="470" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1_inc2" value="finalize_attempt_with_hierarchy&#xa;（与基线同一收口语义）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="620" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p1_n3" value="基线分支 initialize_dbnum_baseline&#xa;读 applied_sesno、pe_count、dbnum_info 计数&#xa;查 DuckLake current_release(dbnum)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="660" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p1_d2" value="baseline_needs_full_parse ?&#xa;pe_count == 0  或  applied_sesno == 0&#xa;或  DuckLake release.end_sesno ≠ file_latest_sesno" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="820" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p1_n4" value="【解析核心】sync_total_async_threaded&#xa;受限选项 baseline_sync_options：&#xa;total_sync=true / replace_dbs=false&#xa;included_db_files=[本文件] / gen_model=false&#xa;详细展开见第 2 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="470" y="990" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p1_n5" value="baseline_model_plan（仅 DESI）&#xa;全库活跃 PE → 归一到生成根 → 去重 → RegenRoot&#xa;CATA / SYS meta 返回空计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="1180" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p1_n6" value="baseline_hierarchy_release&#xa;从 DuckLake 读回 release_id / locator_hash&#xa;再校一次 end_sesno == file_latest_sesno&#xa;对不上就不推进水位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="1320" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p1_n7" value="finalize_baseline_with_hierarchy（单事务）&#xa;写 pending 工作项 + 推进 applied_sesno&#xa;+ 写 hierarchy_release_id / locator_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="470" y="1470" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p1_d3" value="kv-mem readiness 门&#xa;applied_sesno 与 hierarchy_release_id&#xa;是否同时对上当前 release ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="1620" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p1_n8" value="分片冷加载&#xa;per-dbnum 进程内嵌 SurrealDB 实例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="1635" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p1_fail" value="fail-closed&#xa;hierarchy dbnum is not ready&#xa;当前态查询直接失败，不回退旧持久路径&#xa;（回退会让生成观察到混合 release）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1635" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p1_n9" value="drain_non_regen（位姿 / 删除 / 级联）&#xa;→ load_pending_model_units_for_retry(dbnum)&#xa;→ run_unit_worklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="1790" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p1_n10" value="几何生成&#xa;prim_model / loop_model / cata_model / bran_hanger&#xa;→ OCCT 造型 → 网格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="1950" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p1_s1" value="SurrealDB&#xa;pe / pe_owner / ATT_* / ATT_UDA" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="990" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1_s2" value="DuckLake&#xa;hierarchy_node / hierarchy_release&#xa;每次发布 = 一个 snapshot" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="1140" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1_s3" value="SurrealDB&#xa;dbnum_watermark&#xa;model_update_pending" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="1450" width="340" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p1_note1" value="applied_sesno = 应用水位（权威值）&#xa;「我真的处理完并收口到这里了」&#xa;&#xa;file_latest_sesno = 扫描观察值&#xa;「我刚看了一眼，文件长到这」&#xa;两者混用 = 把没处理的当处理过了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1_note2" value="解析本身幂等（replace_dbs=false）&#xa;所以「白跑一遍」只损失时间，&#xa;不损失正确性。&#xa;&#xa;但不要手动开 total_sync：&#xa;sync_pdms 不写水位，独立跑完&#xa;基线路径还会再解析一遍。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1_note3" value="必须先收口再生成：&#xa;生成依赖 current_hierarchy 的当前态&#xa;查询，而它要等 release 写进水位后&#xa;readiness 门才放行。&#xa;&#xa;数据成功、模型失败不回滚数据。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p1_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_t1" target="p1_n1">
