  <diagram name="2-解析核心 sync_total_async_threaded">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2_title" value="解析核心：一次解析，两条互不相干的写路径" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="-50" width="880" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p2_hdr0" value="SurrealDB 写入管线" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_hdr1" value="SurrealDB 生产者" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="600" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_hdr2" value="共用解析主链" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="920" y="0" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_hdr3" value="DuckLake 层级投影" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1440" y="880" width="440" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p2_a1" value="入口 sync_total_async_threaded&#xa;(db_option, project, dbno_set, db_types, progress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="40" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_a2" value="遍历 children_files（逐个 db 文件）&#xa;读 60 字节文件头 parse_file_basic_info → db_type / db_no&#xa;过滤：db_types 命中 + included_db_files&#xa;（SYS 元数据不受 included_db_files 约束，ADR-007）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="180" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_a3" value="PdmsIO::open → get_latest_sesno&#xa;sesno == 0 直接 bail（没有可发布的 session）&#xa;io.open() 顺带构建 ses_range_map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="330" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_a4" value="parse_file_db_basic_data → db_basic&#xa;refno_table_map / children_map / world_refno&#xa;解析失败绝不退化成空库，整批 baseline 失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="470" width="440" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p2_g1" value="门 A · 层级预计算（写盘前）&#xa;1) is_projected_hierarchy_noun 过滤，挡掉 MNUM 等数据库控制记录&#xa;2) children_map → sibling_orders；子节点重复出现 / 父不是元素 → 失败&#xa;3) required_hierarchy_refnos = 全部层级子节点 + world_refno&#xa;4) hierarchy_ref0s 从 refno_table_map 取（排除 0 与哨兵）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="610" width="440" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p2_b1" value="save_pe_relates(db_basic)&#xa;→ SenderJsonsData::PERelateJson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="650" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p2_a5" value="chunk 循环 all_refnos.chunks(sync_chunk_size)&#xa;parse_file_with_chunk(db_basic, chunk, ses_range_map, ignore_world_refno)&#xa;→ total_attr_map / type_ele_map&#xa;（WORL 只在持有它的那一块解析一次）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="800" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p2_b2" value="save_pes(db_basic, total_attr_map, db_no, ...)&#xa;→ SenderJsonsData::PEJson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="940" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_b3" value="按 noun 分表逐条生成 JSON&#xa;att.gen_sur_json() → 属性表&#xa;att.gen_sur_json_uda() → normalize_sql_string → ATT_UDA&#xa;→ SenderJsonsData::AttJson((表名, jsons))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="1070" width="400" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2_c1" value="HierarchyRowV1::from_named_attr_map&#xa;refno 一致性校验（map vs attr）&#xa;validate_member_owner：成员表里的父&#xa;与标量 OWNER 不一致 → 直接失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="940" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_c2" value="hierarchy_rows 内存累加（不立即写盘）&#xa;只有 6 个字段：dbnum / refno / owner / noun / name / sibling_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1090" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_g2" value="门 B · 完整性（单文件解析结束后）&#xa;parsed_refnos 必须覆盖 required_hierarchy_refnos&#xa;缺一个就整库失败，错误里带 parsed / required / missing_sample" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1230" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_g3" value="门 C · BaselineProjection::new_with_ref0s&#xa;ref0 为 0 或哨兵 → 失败；ref0 不在文件索引内 → 失败&#xa;row.dbnum 不符 / refno 重复 → 失败&#xa;validate_hierarchy_rows → 按 refno 排序 → 推入 hierarchy_baselines" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1400" width="440" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p2_d1" value="flume::bounded(BASELINE_QUEUE_CAPACITY)&#xa;背压：无界队列会把未落盘的 INSERT&#xa;payload 全留住，撑爆进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_d2" value="写入 worker × BASELINE_WRITE_WORKERS&#xa;chunks(BASELINE_WRITE_WINDOW)&#xa;execute_surreal_checked + 冲突重试&#xa;（乐观事务下无界并发曾导致静默丢写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1370" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_d3" value="SurrealDB&#xa;INSERT IGNORE INTO pe&#xa;INSERT RELATION INTO pe_owner&#xa;INSERT IGNORE INTO {noun} / ATT_UDA" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1530" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p2_a6" value="finish_write_pipeline(sender, insert_handles, parser_outcome)&#xa;关闭 sender → drain 全部 writer → 汇总解析错误与写入错误&#xa;（解析失败也要先把 writer 排干，再上抛）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="1720" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2_a7" value="spawn_blocking：HierarchyProjectionStore::publish_baseline&#xa;幂等短路：end_sesno + source_digest + change_hash 全等 → already_committed&#xa;release_id = hash(project, dbnum, base_release_id, 0, end_sesno, digest, change_hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="1880" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" value="prepare_locator + stage_locator&#xa;内容寻址 ref0 → dbnum 反查表&#xa;先暂存，不激活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1890" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p2_a8" value="DuckLake 事务（DuckDB ducklake 扩展，SHA256 钉版）&#xa;BEGIN TRANSACTION&#xa;→ DELETE FROM hierarchy_node WHERE dbnum = ?&#xa;→ appender_to_catalog_and_db 逐行追加&#xa;→ INSERT INTO hierarchy_release(...)&#xa;→ CALL set_commit_message('aios', release_id, extra_info =&gt; locator_hash)&#xa;→ COMMIT（失败则 ROLLBACK）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="2060" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2_e2" value="DuckLake&#xa;hierarchy_node（按 dbnum 分区）&#xa;hierarchy_release + snapshot" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="2085" width="440" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p2_a9" value="last_committed_snapshot() → snapshot_id&#xa;返回 ProjectionCommit{release_id, locator_hash, snapshot_id, row_count}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="2290" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_a10" value="evict_global_if_resident(project, dbnum)&#xa;基线换了 → 立刻丢弃可能常驻的 kv-mem 分片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="2430" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_a11" value="define_owner_index / define_pe_index&#xa;rebuild_dbnum_info_from_pe（仅 total_sync）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="2570" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_a12" value="返回 parsed_db_infos（dbnum → 元素数）&#xa;交回 initialize_dbnum_baseline 做收口（第 1 页）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="2710" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p2_note1" value="本页是第 1 页【解析核心】的展开。&#xa;&#xa;基线路径用受限选项调用：&#xa;total_sync=true / replace_dbs=false&#xa;included_db_files=[本文件]&#xa;manual_db_nums=[本 dbnum]&#xa;gen_model=false / gen_mesh=false&#xa;&#xa;所以只解析这一个库，且不顺带生成。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2_note2" value="两条写路径彼此独立，不在同一个事务里：&#xa;· SurrealDB 边解析边流式并发写&#xa;· DuckLake 全部攒在内存，等 SurrealDB&#xa;  写管线收尾后才一次性发布&#xa;&#xa;崩溃窗口（PE 已落、DuckLake 未提交）&#xa;靠水位与 readiness 门兜底，不靠事务。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;dashed=1;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1720" width="320" height="180" as="geometry" />
        </mxCell>

