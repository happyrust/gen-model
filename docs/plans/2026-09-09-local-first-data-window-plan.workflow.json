  "edges": [
    { "from": "plan_lock", "to": "apply_split", "role": "main", "label": "确认重构边界" },
    { "from": "apply_split", "to": "artifact_bundle", "role": "main", "label": "保留 Task 内渲染职责" },
    { "from": "artifact_bundle", "to": "artifact_accept", "role": "main", "label": "runtime.accept LocalWindow" },
    { "from": "artifact_accept", "to": "journal_complete", "role": "main", "label": "complete(Data)" },
    { "from": "journal_complete", "to": "backup_drive", "role": "main", "label": "journal seq 入列" },
    { "from": "backup_drive", "to": "sink_write", "role": "main", "label": "执行下一条 completion" },
    { "from": "sink_write", "to": "db_tail", "role": "return", "label": "结构化行落库成功" },
