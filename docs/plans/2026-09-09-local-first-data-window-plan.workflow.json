    { "id": "artifact_bundle", "lane": "apply", "col": 2, "type": "backend", "label": "组装 artifact", "width": 180 },
    { "id": "artifact_accept", "lane": "journal", "col": 2, "type": "messagebus", "label": "accept", "width": 140 },
    { "id": "journal_complete", "lane": "journal", "col": 2, "type": "database", "label": "complete Data", "sublabel": "Data 阶段先于 watermark", "width": 140, "yOffset": 64 },
    { "id": "backup_drive", "lane": "sink", "col": 2, "type": "backend", "label": "backup 循环", "sublabel": "单游标串行落库", "width": 140 },
