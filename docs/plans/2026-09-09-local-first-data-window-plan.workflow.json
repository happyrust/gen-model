    { "id": "replay_resume", "lane": "store", "col": 2, "type": "backend", "label": "崩溃重放", "sublabel": "领先一窗只补尾事务", "width": 140 },
    { "id": "parity_check", "lane": "verify", "col": 2, "type": "backend", "label": "parity 验证", "sublabel": "window_repair 与表对比", "width": 140 },
    { "id": "release_guard", "lane": "verify", "col": 3, "type": "frontend", "label": "交付结点", "sublabel": "回归、告警与可观测", "width": 140 }
