    { "from": "lane_health", "to": "parity_check", "role": "branch", "label": "对齐可见性与测试结论" },
    { "from": "parity_check", "to": "release_guard", "role": "branch", "label": "确认回归无偏" },
    { "from": "sink_write", "to": "replay_resume", "role": "error", "label": "中途失败则记 error 并重放" },
    { "from": "replay_resume", "to": "lane_health", "role": "branch", "label": "重建后继续消费" }
  ]
