-/// 一个库的打开态：引擎（已钉会话）+ 该库类型的模板 provider。
-///
-/// 与 gen-model `DirectStore` 的 `DbSession` 同构；文件身份守卫（FileReplaced）
-/// 是水位/工程语义，留在消费方，这里不复制。
-struct OpenDb {
-    dbno: u32,
-    engine: ReadOnlyEngine,
-    provider: TemplateProvider,
-    /// 实际钉住的会话号：`pin.sesno` 给了就是它，没给就是开库时解出的冻结点。
-    pinned_sesno: u32,
-}
-
-impl OpenDb {
-    fn open(pin: &DbFilePin) -> Result<Self, DbElementError> {
-        let fail = |detail: String| DbElementError::Open {
-            file: pin.file.clone(),
-            detail,
-        };
-        let engine = match pin.sesno {
-            Some(sesno) => ReadOnlyEngine::open_at(&pin.file, sesno),
-            None => ReadOnlyEngine::open(&pin.file),
-        }
-        .map_err(|error| fail(format!("open at {:?}: {error}", pin.sesno)))?;
-
-        let dbno = engine.descriptor().db_mark;
-        let pinned_sesno = engine.session().sesno;
-
-        let expected_type = pin.db_type.as_deref().map(e3d_attlib::db1_hash);
-        let provider = TemplateProvider::open(&pin.template, expected_type)
-            .map_err(|error| fail(format!("open template {}: {error}", pin.template.display())))?;
-
-        Ok(Self {
-            dbno,
-            engine,
-            provider,
-            pinned_sesno,
-        })
-    }
-}
