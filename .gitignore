/target
.idea/
/assets/
/asset/
models/
watcher.json
/all_attr_info.json
# 空间树时点快照：V2 单文件 accel_tree_<project>.snapshot（2026-08-12 方案），
# 旧格式 bin + meta.json 仅剩迁移候选；全部随时可从库指针重建。
accel_tree*.snapshot
accel_tree*.snapshot.tmp
accel_tree*.bin
accel_tree*.meta.json
/pdms-io/
aios-database.exe
mqtt-server.exe
simple-http-server.exe

# 运行与调试产生的临时产物（生成日志、进程日志、导出的 mesh）
*.log
*.obj
logs_*.txt

# bin/surreal.exe 起的本地工作库数据目录（rocksdb，随时可重灌）
/.surreal/

# 按端口区分的站点运行目录（scripts/Invoke-SiteDbnumParse.ps1 生成，随时可重建）
/.sites/

# 本地工具缓存与手动配置备份（可重建 / 仅本机有效）
.sigmap-cache.json
.brooks-lint-history.json
*.gm9bak

# 根目录下以下划线开头的一次性排查/探针产物（_sys_parse、_ref_rev_probe 等）
/_*

# 手工备份、加速结构时点快照与编译器崩溃转储（可从当前配置 / 重新解析重建）
*.bak-*
DbOption.toml.*
rustc-ice-*.txt

# 本地 vendor 克隆：Cargo.toml 已按 git URL + rev 拉取 aios-parse-pdms / occt-rs，
# 这里的副本自带 .git，入库会变成拉不出来的 gitlink
/vendor/

# 下载的第三方工具二进制（surreal.exe 等）
/bin/*.exe

# perf 测试每次运行都会重写，不反映代码状态
/performance_trace.json

# 逆向 / Agent 会话工作区与本地 agent 会话状态，仅本机有效
/.ida_scratch/
/.context/
/.cursor/rules/pchat.mdc
/.codex/

# 按 issue / 场次归档的一次性实测工作区（截图、抓取、备份 JSON、临时 exe）
/.fable1-e2e/
/.issue5-retest/
/.issue7-retest/
/.simshots/
/test_output/

# 根目录一次性调试脚本、diff 暂存与抓屏
/.tmp-*
/.diff-*.txt
/.sim-check.js
/.sim-drive.js
/.surreal-inventory.pid
/commit-msg-tmp.txt
/compare-plantui.png
/manual-update-sim.html

# 根目录一次性查询与命令历史残留
/history.txt
/inst_relate
/dc_probe.sql
/gm_noun_caps_probe.py

__pycache__/
*.pyc
# maturin develop 会把编译好的扩展拷进包目录（python/pysrc/aios_db/_aios_db.pyd）
*.pyd
# uv venv 自带内部 .gitignore 自忽略，这里再显式钉一条兜底
/python/.venv/

# 会话草稿工作区（仓库根与 python/ 下都会出现，只在本机有意义）
.scratch/

# Python 绑定测试沙箱的重型/可再生数据（配置与脚本入库；数据用
# python/testbed/Sync-TestbedProjects.ps1 重灌，SurrealDB 数据目录可随时重基线）
/python/testbed/projects/
/python/testbed/.surreal/
/python/testbed/meshes/
/python/testbed/out/

# ams8000 空间树增量回放驱动（spatial_tree_8000.py）的运行产物
/python/testbed/meshes-spatial8000/
/python/testbed/meshes-spatial8000-oracle/
/python/testbed/.spatial8000/
# 从 python/ 目录跑 `surreal sql` 留下的 CLI 交互历史（根级 /history.txt 盖不住这层）
/python/history.txt

# 房间增量 pytest 的夹具 mesh 产物（conftest 自建，随时可重造）
/python/tests/.meshes/

# output/ 是运行产物目录（截图、跑批日志、控制台抓取、E3D 插件 DLL、一次性 SurrealQL、
# 逆向中间快照、按场次归档的演练目录），默认全忽略；只放行下列仓库资产：
#   - 探针脚本
#   - noun_layout.json：ADR-008 寻址模型权威快照，src/bin/noun_layout*_probe.rs 硬编码读取
#   - increment-test 里已策展的那组记录（新截图默认不入库）
/output/*
!/output/*.py
!/output/noun_layout.json
!/output/increment-test/
/output/increment-test/*
!/output/increment-test/README.md
!/output/increment-test/rs-plant3-d-*.png

# CI 诊断产物落脚处（windows-tests 的会话对回归把台账与完整输出留在这里，
# 失败时当 artifact 传出来）。本地照 CI 那段命令演练时同样会生成。
/artifacts/

# KC-Chat 运行时产物（插件自动生成，请勿入库）
.cursor/mcp.json
.cursor/kc-mcp/
.cursor/kc-mcp-messages/
.cursor/kc-chat-exports/
